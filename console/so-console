def interactive(c):
    while True:
        print()
        print(col(B, '╭' + '─' * 61))
        print(col(B, '│ so-console %s   %-12s %-22s' % (VERSION, c['arch'] or arch(),
                                                       time.strftime('%F %T'))))
        print(col(B, '╰' + '─' * 61))
        for group, items in MENU:
            print('  ' + col(D, '── %s %s' % (group, '─' * (38 - len(group)))))
            for num, name, desc in items:
                print('   %s %s %s' % (col(B, num.rjust(2)), col(B, name.ljust(9)), desc))
        print('    0 %s %s' % (col(B, 'quit'.ljust(9)), '退出'))
        try:
            sel = input('\n  so> ').strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if sel in ('0', 'q', 'quit', 'exit'):
            return 0
        if not sel:
            continue
        name = None
        for _, items in MENU:
            for num, cmd_name, _desc in items:
                if sel == num:
                    name = cmd_name
        if name is None:
            parts = sel.split()
            name = parts[0] if parts else ''
            argv = parts[1:]
        else:
            argv = []
        if name in ('install', 'inst', 'service', 'probe', 'logs', 'routes', 'rollback'):
            extra = input('  %s 参数（回车 = 交互/默认）: ' % name).split()
            argv = argv + extra
        dispatch(c, name, argv)


