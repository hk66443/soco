def conf_check(c, path=None, quiet=False):
    """对比当前配置与原版 soga 2.18.1 模板：缺键 / 多键 / 固定项取值。返回 (missing, extra, diff)。"""
    path = Path(path or c['conf'])
    keys = parse_conf(path)
    tmpl = conf_template_keys()
    tset = set(tmpl)
    missing = [k for k in tmpl if k not in keys]
    extra = [k for k in keys if k not in tset]
    diff = [(k, keys.get(k, ''), v) for k, v in CONF_OPTIONAL.items()
            if k in keys and keys.get(k, '') != v]
    if quiet:
        return missing, extra, diff
    head('配置一致性（对比原版 soga 2.18.1 模板）')
    kv('配置文件', str(path) + ('' if path.is_file() else '  （不存在）'))
    kv('模板键数 / 当前键数', '%d / %d' % (len(tmpl), len(keys)))
    if not path.is_file():
        bad('配置不存在，先跑 so-console install')
        return missing, extra, diff
    if missing:
        bad('缺少 %d 个原版键：%s' % (len(missing), ', '.join(missing)))
        warn('重跑 so-console install 会按原版模板补齐（客户已有值保留）')
    else:
        ok('原版模板 %d 个键全部具备，结构与原版一致' % len(tmpl))
    if extra:
        warn('多出 %d 个模板外键（自定义项，正常保留）：%s' % (len(extra), ', '.join(extra)))
    if diff:
        warn('%d 个可选键已偏离原版默认（客户自定义，install 会保留）：' % len(diff))
        for k, cur, dft in diff:
            print('    %-26s %s（原版默认 %s）' % (k, cur or '(空)', dft))
    fixed_keys = ('type', 'api', 'check_interval', 'submit_interval')
    fixed_bad = [(k, keys.get(k, ''), FIXED[k]) for k in fixed_keys
                 if k in keys and keys.get(k) != FIXED[k]]
    lvl = keys.get('log_level', FIXED['log_level'])
    if lvl not in LOG_LEVELS:                 # 只认 error/info；其它值才算改坏
        fixed_bad.append(('log_level', lvl, FIXED['log_level']))
    if fixed_bad:
        # 注意：这里以前写的是 `k, a, b`，而 `a` 在 conf_check() 里不存在——
        # 只要客户改了 type/api/间隔/log_level，conf check 就会 NameError 崩掉。
        warn('固定项被改动（建议改回）：%s' % ', '.join('%s=%s→%s' % (k, cur or '-', want)
                                                   for k, cur, want in fixed_bad))
    else:
        ok('固定项符合预期：type/api/间隔')
    if lvl == 'info':
        say('  日志级别 log_level=info（允许的选项）：会写审计流水，本地人数可读；'
            '磁盘吃紧可改回 error')
    return missing, extra, diff


def cmd_conf(c, a):
    path = Path(a.path or c['conf'])
    if a.action == 'get':
        # `conf get webapi_key`：键名可能落在 path 位置参数上（位置参数被 show/check 复用）
        k = (getattr(a, 'key', None) or '').strip()
        if a.path and not Path(a.path).is_file():
            path = Path(c['conf'])            # 第一个位置参数不是文件 → 当作键名
            k = k or a.path.strip()
        if not k:
            bad('用法：conf get <键名>（conf keys 可列出全部键）')
            return 2
        vals = parse_conf(path)
        if k not in vals:
            bad('%s 里没有键 %s' % (path, k))
            return 1
        print(vals[k])            # 完整值：本地运维要复制到面板时用（conf show 会脱敏）
        return 0
    if a.action == 'show':
        if not path.is_file():
            bad('配置不存在：%s' % path)
            return 1
        for ln in path.read_text(encoding='utf-8', errors='replace').splitlines():
            s = ln.strip()
            if '=' in s and not s.startswith('#'):
                k, v = s.split('=', 1)
                if re.search(r'key|pass|token|secret|uuid', k, re.I) and len(v.strip()) > 6:
                    print('%s=%s…（已脱敏）' % (k, v.strip()[:6]))
                    continue
            print(ln)
        return 0
    if a.action == 'keys':
        if not path.is_file():
            bad('配置不存在：%s' % path)
            return 1
        keys = list(parse_conf(path))
        print(' '.join(keys))
        kv('当前键数', len(keys))
        kv('原版模板键数', len(conf_template_keys()))
        return 0
    missing, _extra, _diff = conf_check(c, path)
    return 1 if missing else 0


