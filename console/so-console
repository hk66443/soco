def interactive(c):
    while True:
        print()
        print(col(B, '╭' + '─' * 61))
        print(col(B, '│ so-console %s   %-12s %-22s' % (VERSION, c['arch'] or arch(),
                                                       time.strftime('%F %T'))))
        print(col(B, '╰' + '─' * 61))
        for group, items in MENU:
            print('  ' + col(D, '── %s %s' % (group, '─' * (38 - len(group)))))
            for num, name, desc in items:
                print('   %s %s %s' % (col(B, num.rjust(2)), col(B, name.ljust(9)), desc))
        print('    0 %s %s' % (col(B, 'quit'.ljust(9)), '退出'))
        try:
            sel = input('\n  so> ').strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        low = sel.lower()
        if low in ('0', 'q', 'quit', 'exit'):
            return 0
        if low in ('?', 'h', 'help'):
            print(USAGE)
            continue
        if not sel:
            continue
        name = None
        for _, items in MENU:
            for num, cmd_name, _desc in items:
                if sel == num:
                    name = cmd_name
        if name is None:
            parts = sel.split()
            name = parts[0].lower() if parts else ''
            argv = parts[1:]
        else:
            argv = []
        # 只有「需要参数」的命令才追问；回车 = 直接执行（以前回车会再问一次，导致同一条命令跑两遍）
        if name in NEEDS_ARG and not argv:
            try:
                extra = input('  %s 参数（回车 = 交互/默认）: ' % name).split()
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
            argv = argv + extra
        try:
            dispatch(c, name, argv)
        except Cancelled:
            print()
            warn('已取消，回到菜单')


