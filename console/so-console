    ps = sub.add_parser('service', add_help=False)
    ps.add_argument('action', nargs='?', default='status',
                    choices=['start', 'stop', 'restart', 'status'])

    pp = sub.add_parser('probe', add_help=False)
    pp.add_argument('count', nargs='?', default='3')
    pp.add_argument('idx', nargs='?')

    pl = sub.add_parser('logs', add_help=False)
    pl.add_argument('unit', nargs='?')
    pl.add_argument('lines', nargs='?')          # 不交给 argparse 转 int：否则非法值直接 SystemExit

    pr = sub.add_parser('routes', add_help=False)
    pr.add_argument('action', nargs='?', default='status', choices=['status', 'show', 'validate'])

    pb = sub.add_parser('rollback', add_help=False)
    pb.add_argument('file', nargs='?', help='备份文件（也可以写 --file）')
    pb.add_argument('--file', dest='file_opt', help='备份文件（等价写法）')
    pb.add_argument('--yes', '-y', action='store_true', help='非交互回滚时显式确认')

    pbk = sub.add_parser('backup', add_help=False)
    pbk.add_argument('--keep', type=int)

    pu = sub.add_parser('uninstall', add_help=False)
    pu.add_argument('--purge', action='store_true', help='连配置（/etc/soga）一起删')
    pu.add_argument('--yes', '-y', action='store_true', help='非交互确认')

    for name in ('status', 'users', 'gate', 'doctor', 'verify', 'paths', 'help', 'version'):
        sub.add_parser(name, add_help=False)

    pc = sub.add_parser('conf', add_help=False)
    pc.add_argument('action', nargs='?', default='check',
                    choices=['check', 'show', 'keys', 'get'])
    pc.add_argument('path', nargs='?')
    pc.add_argument('key', nargs='?')       # conf get <键名>（screen 上按位置填到 path 也行）
    return p


