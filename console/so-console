def cmd_status(c, _a):
    svc = c['service']
    head('状态总览  %s' % time.strftime('%F %T'))
    pid = main_pid(svc)
    port = port_of_service(svc) or det_port(c)
    log = journal(svc, '-10min')
    kv('架构', '%s (host=%s)' % (c['arch'] or arch(), arch()))
    kv('主服务', '%s pid=%s restarts=%s' % (svc_state(svc), pid or '-',
                                            out(['systemctl', 'show', svc, '-p', 'NRestarts', '--value'])))
    if pid and pid not in ('0', ''):
        raw = out(['ps', '-o', 'etime=,rss=,pcpu=', '-p', pid]).split()
        if len(raw) >= 3:
            kv('运行时长/内存/CPU', '%s / %d MB / CPU %s%%' % (raw[0], int(raw[1]) // 1024, raw[2]))
        else:
            kv('运行时长/内存/CPU', ' '.join(raw) or '-')
    kv('业务端口', '%s (%s)' % (port or '-', 'LISTEN' if port and ':' + port in out(['ss', '-lnt']) else 'DOWN'))
    unum, usrc = last_user_num(svc, with_src=True)
    if usrc.endswith('（实时）'):
        kv('用户（本地）', unum)
    elif unum == '-':
        kv('用户（本地）', '%s  %s' % (unum, usrc))
    else:
        kv('用户（本地）', '%s（历史快照，仅供参考）' % unum)
    kv('闸门计数(10m)', 'key_err=%d auth_fail=%d relay=%d'
       % (log.count('soga key'), log.count('auth failed'), log.count('tcp relay')))
    kv('分流（只读）', last_routes_line(svc))
    for u in ('soco-licence-sink', 'soco-sink-redirect', 'soco-watchdog'):
        kv(u, svc_state(u))
    insts = sorted(p.stem for p in Path(c['inst_dir']).glob('*.conf') if p.stem != 'soga')
    kv('实例', ', '.join(insts) or '-')
    binf = Path(c['bin_dir']) / 'soco'
    kv('主程序', (out(['sha256sum', str(binf)])[:16] or '-') if binf.is_file() else 'MISSING')
    return 0


def cmd_service(c, a):
    act = getattr(a, 'action', None) or 'status'
    svc = c['service']
    if act not in ('start', 'stop', 'restart', 'status'):
        bad('用法：service start|stop|restart|status（收到 %s）' % act)
        return 2
    if act == 'status':
        return cmd_status(c, a)
    head('%s %s' % (act, svc))
    if act != 'stop':
        for u in ('soco-licence-sink', 'soco-sink-redirect'):
            sh(['systemctl', 'start', u])
    rc, s = sh(['systemctl', act, svc + '.service'])
    ok(s.strip() or 'done')
    if act in ('start', 'restart'):
        # 以前固定 sleep 2 就打 status：soco 实测要 10–19 s 才监听，用户看到 DOWN 会以为重启失败
        port = ''
        for _ in range(24):
            time.sleep(1.5)
            port = port_of_service(svc) or det_port(c)
            if port and (':%s' % port) in out(['ss', '-lnt']):
                break
        if port and (':%s' % port) in out(['ss', '-lnt']):
            ok(':%s 已就绪' % port)
        else:
            warn('端口还没起来（实测就绪 10–19 s），稍后 so-console status / logs 看一眼')
    else:
        time.sleep(1)
    return cmd_status(c, a)


def cmd_users(c, _a):
    head('用户数对照')
    local, lsrc = last_user_num(c['service'], with_src=True)
    kv('本地（日志）', local if lsrc.endswith('（实时）') else '%s  %s' % (local, lsrc))
    n = panel_users(c)
    if n is None:
        bad('面板接口失败（查 webapi_url / webapi_key / 网络）')
        return 1
    kv('面板（UniProxy）', '%d 个用户' % n)
    lvl = level_of(c['conf'])
    if local == '-':
        if lvl == 'info':
            warn('log_level=info 已开，但还没读到 INFO 行（刚重启？）——等一个 check_interval（60 s）再看')
        else:
            warn('本地人数读不到（log_level=error 不写 INFO 行）；面板侧 %d 个用户；'
                 '要本地对照就带 --log-level info 重装一次（会重启 soco，约 15 s）' % n)
    elif lsrc.startswith('journal'):
        if local == str(n):
            ok('对照一致（本地实时）')
        else:
            warn('本地 %s ≠ 面板 %d → 服务端日志可能还没拉齐，等一个 check_interval（60 s）再看；'
                 '仍不一致就 so-console logs %s 80' % (local, n, c['service']))
    else:
        # 历史快照不能当"本地人数"去和面板比 —— 以前会因此报出一条假的「不一致」
        warn('本地只有历史快照（%s），不参与一致性判断；面板侧 %d 个。'
             '要实时对照就带 --log-level info 重装（会重启 soco）' % (lsrc, n))
    return 0


def cmd_probe(c, a):
    n = str(getattr(a, 'count', None) or '3')
    if n not in ('all', 'full'):
        try:
            cnt = int(n)
        except ValueError:
            bad('数量只能是正整数或 all：%s' % n)
            return 2
        if cnt < 1:
            bad('数量必须 ≥ 1（收到 %d）' % cnt)
            return 2
        n = str(cnt)
    script = probe_script(c)
    if n in ('all', 'full') and sys.stdin.isatty():
        total = panel_users(c)
        if not confirm('probe all 会逐个用户真实握手%s，可能跑很久，继续？'
                       % ('（面板 %d 个）' % total if total else '')):
            return 0
    if script is None:
        bad('找不到 probe_many.py（先 so-console install，或放进 %s）' % c['bin_dir'])
        return 2
    if probe_client(c) is None:
        bad('找不到探测客户端（sing-box-probe），放在 %s/sing-box-probe 后重试（DEPLOY.md §2.1）'
            % c['bin_dir'])
        return 2
    idx = (getattr(a, 'idx', None) or '').replace(' ', '')
    if idx and not re.fullmatch(r'\d+(,\d+)*', idx):
        bad('用户索引只能是逗号分隔的数字：%s（例：probe 3 1,2,3）' % idx)
        return 2
    cmd = ['python3', '-u', str(script), n]
    if idx:
        cmd.append(idx)
    head('真实握手  %s' % ' '.join(cmd[2:]))
    t0 = time.time()
    rc, s = sh(cmd, timeout=7200)
    total_ok = total_n = None
    for ln in s.splitlines():
        ln = ln.strip()
        if ln.startswith('TOTAL'):
            m = re.search(r'ok=(\d+)/(\d+)', ln)
            if m:
                total_ok, total_n = int(m.group(1)), int(m.group(2))
                (ok if total_ok == total_n else bad)(ln)
        elif ln.startswith('users='):
            kv('抓取', ln[:120])
        elif ln.startswith('FAIL') or ' FAIL ' in ln:
            bad(ln[:140])
    if rc != 0:
        # 探针自己崩了（比如索引非法 / 面板拉不到用户）时，别只留一个「退出码 1」
        tail = [ln for ln in s.splitlines() if ln.strip() and not ln.startswith('TOTAL')]
        if not total_n or total_n == 0:
            bad('探针没有产出任何结果，尾部输出：')
            for ln in tail[-4:]:
                print('    ' + ln[:140])
        elif tail:
            warn('探针尾部输出：')
            for ln in tail[-3:]:
                print('    ' + ln[:140])
    if total_n is not None and idx and total_ok == total_n and total_n < int(n):
        warn('只测了 %d 个：索引越界（超出面板用户数）的会被跳过' % total_n)
    kv('退出码', rc)
    kv('耗时', '%ds' % round(time.time() - t0))
    return 0 if rc == 0 else 1


