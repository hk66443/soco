ROUTES_AREAS = {
    'us': ('node-us', '38383'), 'hk': ('node-hk', '38888'), 'tw': ('node-tw', '20558'),
    'jp': ('node-jp', '38123'), 'kr': ('node-kr', '23355'), 'sg': ('node-sg', '20955'),
    'uk': ('node-uk', '25253'),
}


def cmd_routes(c, a):
    svc = c['service']
    rp = Path(c['inst_dir']) / 'routes.toml'
    act = a[0] if a else 'list'
    if act == 'list':
        if not rp.is_file():
            print('no routes file (%s)' % rp)
            return 1
        t = rp.read_text(errors='replace')
        print('file   : %s (%d bytes)' % (rp, len(t)))
        print('rules  : %d' % len(re.findall(r'^\[\[routes\]\]', t, re.M)))
        m = re.search(r'\[\[routes\.Outs\]\][^\[]*', t, re.S)
        if m:
            srv = re.search(r'server\s*=\s*"([^"]+)"', m.group(0))
            port = re.search(r'port\s*=\s*(\d+)', m.group(0))
            print('first  : %s:%s' % (srv.group(1) if srv else '?', port.group(1) if port else '?'))
        print('loaded : %s' % last_routes_line(svc))
        return 0
    if act == 'switch':
        area = (a[1] if len(a) > 1 else 'us').lower()
        if area not in ROUTES_AREAS:
            print('areas: %s' % ', '.join(ROUTES_AREAS))
            return 2
        if not rp.is_file():
            print('no routes file')
            return 1
        srv, port = ROUTES_AREAS[area]
        shutil.copy2(rp, str(rp) + '.bak.%s' % time.strftime('%Y%m%dT%H%M%S'))
        t = rp.read_text(errors='replace')
        i = t.find('[[routes.Outs]]')
        j = t.find('[[routes]]', i)
        seg = t[i:j if j > 0 else len(t)]
        new = re.sub(r'server\s*=\s*"[^"]*"', 'server="%s"' % srv, seg, count=1)
        new = re.sub(r'port\s*=\s*\d+', 'port=%s' % port, new, count=1)
        rp.write_text(t[:i] + new + t[j if j > 0 else len(t):])
        os.utime(rp)
        time.sleep(3)
        print('switched first Outs -> %s:%s' % (srv, port))
        return cmd_routes(c, ['list'])
    if act == 'validate':
        if not rp.is_file():
            print('no routes file')
            return 1
        rc, s = sh(['python3', '-c',
                    'import sys,tomllib;d=tomllib.load(open(sys.argv[1],"rb"));'
                    'print("toml ok routes=%d" % len(d.get("routes",[])))', str(rp)])
        print(s.strip() or 'invalid')
        return rc
    print('usage: routes list|switch <us|hk|tw|jp|kr|sg|uk>|validate')
    return 2


def cmd_inst(c, a):
    act = a[0] if a else 'list'
    d = Path(c['inst_dir'])
    if act == 'list':
        for p in sorted(d.glob('*.conf')):
            name = p.stem
            print('%-12s %-10s %s' % (name, svc_state('soco@%s' % name),
                                      out(['systemctl', 'show', 'soco@%s' % name, '-p', 'NRestarts', '--value']) or '-'))
        return 0
    if act == 'new':
        if len(a) < 2:
            print('usage: inst new <name> [node_id=N] [webapi_url=U] [webapi_key=K] [soga_key=K]')
            return 2
        name = a[1]
        dst = d / ('%s.conf' % name)
        if dst.exists():
            print('exists: %s' % dst)
            return 1
        t = Path(c['conf']).read_text()
        for kv in a[2:]:
            if '=' not in kv:
                continue
            k, v = kv.split('=', 1)
            t = re.sub(r'(?m)^%s\s*=.*$' % re.escape(k), '%s=%s' % (k, v), t) \
                if re.search(r'(?m)^%s\s*=' % re.escape(k), t) else t + '\n%s=%s\n' % (k, v)
        shutil.copy2(Path(c['conf']), dst)
        dst.write_text(t)
        os.chmod(dst, 0o600)
        print('created %s' % dst)
        return cmd_inst(c, ['list'])
    if act in ('start', 'stop', 'restart', 'log'):
        if len(a) < 2:
            print('usage: inst %s <name>' % act)
            return 2
        name = a[1]
        if act == 'log':
            rc, s = sh(['journalctl', '-u', 'soco@%s' % name, '-n', '60', '-o', 'cat'])
            print(s.rstrip())
            return 0
        sh(['systemctl', act, 'soco@%s' % name])
        return cmd_inst(c, ['list'])
    if act == 'remove':
        if len(a) < 2:
            print('usage: inst remove <name>')
            return 2
        name = a[1]
        sh(['systemctl', 'disable', '--now', 'soco@%s' % name])
        (d / ('%s.conf' % name)).unlink(missing_ok=True)
        print('removed %s' % name)
        return cmd_inst(c, ['list'])
    print('usage: inst list|new|start|stop|restart|log|remove')
    return 2


