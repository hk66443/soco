        url.rstrip('/'), nid, nt, key)
    rc, s = sh(['curl', '-sS', '--max-time', '20', u])
    try:
        print('panel users                : %d' % len(json.loads(s)['users']))
    except Exception:
        print('panel users                : <fetch failed> %s' % s[:100].replace(key, '***'))
    return 0


