CMDS = {
    'install': cmd_install, 'status': cmd_status, 'service': cmd_service,
    'users': cmd_users, 'probe': cmd_probe, 'gate': cmd_gate, 'routes': cmd_routes,
    'inst': cmd_inst, 'logs': cmd_logs, 'backup': cmd_backup, 'rollback': cmd_rollback,
    'verify': cmd_verify, 'doctor': cmd_doctor, 'paths': cmd_paths, 'conf': cmd_conf,
    'version': cmd_version, 'uninstall': cmd_uninstall,
}


def dispatch(c, name, argv):
    if name in ('help', '-h', '--help', ''):
        print(USAGE)
        return 0
    fn = CMDS.get(name)
    if not fn:
        bad('未知命令：%s（so-console help）' % name)
        return 2
    parser = build_parser()
    try:
        args = parser.parse_args([name] + list(argv))
    except SystemExit:
        return 2
    try:
        return fn(c, args)
    except Cancelled:
        print()
        warn('已取消（输入流结束 / Ctrl+C），没有做任何改动')
        return 130


def main():
    c = cfg_load()
    if not c['arch']:
        c['arch'] = arch()
    if len(sys.argv) == 1:
        return interactive(c)
    if sys.argv[1] in ('-v', '--version'):
        return cmd_version(c, None)
    rc = dispatch(c, sys.argv[1], sys.argv[2:])
    return rc if isinstance(rc, int) else 0


if __name__ == '__main__':
    sys.exit(main())