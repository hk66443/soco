def cmd_backup(c, _a):
    ts = time.strftime('%Y%m%d-%H%M%S')
    dst = Path('/root/so-backup-%s.tar.gz' % ts)
    with tarfile.open(dst, 'w:gz') as t:
        for p in (c['bin_dir'], c['inst_dir']):
            if Path(p).exists():
                t.add(p)
    print('backup -> %s (%d KB)' % (dst, dst.stat().st_size // 1024))
    return 0


def cmd_rollback(c, a):
    cands = sorted(Path('/root').glob('so-backup-*.tar.gz'))
    if not cands:
        print('no backups in /root')
        return 1
    if a:
        pick = Path(a[0])
    else:
        for i, p in enumerate(cands, 1):
            print('%2d) %s' % (i, p))
        sel = input('restore which # (empty=abort): ').strip()
        if not sel:
            return 0
        pick = cands[int(sel) - 1]
    sh(['systemctl', 'stop', c['service']])
    with tarfile.open(pick, 'r:gz') as t:
        t.extractall('/')
    sh(['systemctl', 'start', c['service']])
    print('restored %s' % pick)
    return cmd_status(c, [])


def cmd_verify(c, _a):
    bd = Path(c['bin_dir'])
    print('== fingerprints')
    for n in ('soco', 'libsoco.so'):
        f = bd / n
        print('  %-12s %s' % (n, out(['sha256sum', str(f)])[:16] if f.is_file() else 'MISSING'))
    if (bd / 'soco').is_file():
        print('  file magic  %s' % out(['file', '-b', str(bd / 'soco')])[:60])
    print('== unit wiring')
    u = Path('/etc/systemd/system/%s.service' % c['service'])
    if u.is_file():
        for ln in u.read_text().splitlines():
            if ln.startswith(('ExecStart', 'Environment')):
                print('  ' + ln)
    print('== adapter loaded')
    pid = main_pid(c['service'])
    print('  %s' % ('yes' if pid and 'libsoco' in out(['cat', '/proc/%s/maps' % pid]) else 'NO â€” LD_PRELOAD missing or .so unreadable'))
    return 0


def cmd_doctor(c, _a):
    rows = []

    def chk(name, ok, hint=''):
        rows.append((name, bool(ok), hint))

    bd = Path(c['bin_dir'])
    chk('binaries present', (bd / 'soco').is_file() and (bd / 'libsoco.so').is_file(), 'run install')
    chk('config present', Path(c['conf']).is_file(), 'place the node config at %s' % c['conf'])
    chk('service active', svc_state(c['service']) == 'active', 'service start')
    chk('port listening', bool(det_port(c)) and (':' + det_port(c)) in out(['ss', '-lnt']), 'check config listen port')
    chk('sink active', svc_state('soco-licence-sink') == 'active', 'install')
    chk('sink port 38443', ':38443' in out(['ss', '-lnt']), 'install')
    chk('nft redirect', '38443' in out(['nft', 'list', 'ruleset']), 'install')
