def cfg_load():
    d = dict(DEF)
    if CFG.is_file():
        for line in CFG.read_text(encoding='utf-8').splitlines():
            if '=' in line and not line.lstrip().startswith('#'):
                k, v = line.split('=', 1)
                d[k.strip()] = v.strip()
    return d


def cfg_save(d):
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(''.join('%s=%s\n' % (k, v) for k, v in d.items()), encoding='utf-8')


def sh(cmd, timeout=180):
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except subprocess.TimeoutExpired:
        return 124, 'timeout'
    except FileNotFoundError as e:
        return 127, str(e)


def out(cmd):
    return sh(cmd)[1].strip()


def is_root():
    return getattr(os, 'geteuid', lambda: 0)() == 0


def arch():
    m = os.uname().machine if hasattr(os, 'uname') else ''
    return 'arm64' if m in ('aarch64', 'arm64') else 'amd64'


def read_hosts():
    try:
        return Path('/etc/hosts').read_text(errors='replace')
    except OSError:
        return ''


def svc_state(name):
    return (out(['systemctl', 'is-active', name]) or 'unknown')


def main_pid(svc):
    return out(['systemctl', 'show', svc, '-p', 'MainPID', '--value'])


def svc_props(svc, *props):
    args = ['systemctl', 'show', svc]
    for prop in props:
        args += ['-p', prop]
    return out(args + ['--value']).split('\n')


def journal(svc, since='-10min', timeout=90):
    return sh(['journalctl', '-u', svc, '--since', since, '-o', 'cat'], timeout=timeout)[1]


def last_user_num(svc):
    nums = re.findall(r'current user num:\s*(\d+)', journal(svc, '-20min'))
    return nums[-1] if nums else '-'


def last_routes_line(svc):
    # journalctl --grep 由 systemd 侧过滤（注意：不要加 -n，-n 在过滤前截断，会漏）
    rc, s = sh(['journalctl', '-u', svc, '--grep', 'load routes config', '-o', 'cat'],
               timeout=120)
    if rc != 0 or 'load routes config' not in s:
        s = sh(['journalctl', '-u', svc, '-n', '4000', '-o', 'cat'], timeout=90)[1]
        s = '\n'.join(l for l in s.splitlines() if 'load routes config' in l)
    for ln in reversed(s.strip().splitlines()):
        if 'load routes config' in ln:
            return ln.split('load routes config')[-1].strip()[:90]
    return '-'


def resolve_pkg(c):
    """项目目录：配置里的 pkg 可能过时（比如用 SO_DEST 装到别处），以实际位置为准。"""
    here = Path(__file__).resolve().parent.parent
    for p in (Path(c['pkg']), here, Path('/root/so')):
        if (p / '_ops' / 'probe_many.py').is_file() or (p / 'packaging').is_dir():
            return p
    return Path(c['pkg'])


def probe_script(c):
    for p in (Path(c['bin_dir']) / 'probe_many.py', resolve_pkg(c) / '_ops' / 'probe_many.py',
              resolve_pkg(c) / 'probe_many.py', Path('/root/soco-pkg/probe_many.py')):
        if p.is_file():
            return p
    return None


def elf_machine(path):
    """ELF e_machine：62 = x86-64，183 = AArch64。"""
    try:
        b = Path(path).read_bytes()[:20]
    except OSError:
        return None
    if b[:4] != b'\x7fELF':
        return None
    return int.from_bytes(b[18:20], 'little')


ARCH_EM = {'amd64': 62, 'arm64': 183}


def probe_client(c):
    """sing-box 客户端（真实握手探测用），仓库不含这个二进制。"""
    for p in (Path(c['bin_dir']) / 'sing-box-probe', Path(c['bin_dir']) / 'sing-box',
              Path(c['pkg']) / 'bin' / 'sing-box-probe', Path('/tmp/sing-box')):
        if p.is_file() and os.access(str(p), os.X_OK):
            return p
