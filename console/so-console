# ------------------------------------------------------------------ plumbing
def cfg_load():
    d = dict(DEF)
    if CFG.is_file():
        for line in CFG.read_text(encoding='utf-8').splitlines():
            if '=' in line and not line.lstrip().startswith('#'):
                k, v = line.split('=', 1)
                d[k.strip()] = v.strip()
    return d


def cfg_save(d):
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text('\n'.join('%s=%s' % (k, v) for k, v in d.items()) + '\n', encoding='utf-8')


def sh(cmd, timeout=120):
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except subprocess.TimeoutExpired:
        return 124, 'timeout: %s' % cmd
    except FileNotFoundError as e:
        return 127, str(e)


def out(cmd):
    return sh(cmd)[1].strip()


def read_hosts():
    try:
        return Path('/etc/hosts').read_text(errors='replace')
    except OSError:
        return ''


def arch():
    m = os.uname().machine if hasattr(os, 'uname') else ''
    return 'arm64' if m in ('aarch64', 'arm64') else 'amd64'


def svc_state(name):
    rc, s = sh(['systemctl', 'is-active', name])
    return s.strip() or 'unknown'


def main_pid(svc):
    return out(['systemctl', 'show', svc, '-p', 'MainPID', '--value'])


def journal_has(svc, pattern, since='-5min'):
    rc, s = sh(['journalctl', '-u', svc, '--since', since, '-o', 'cat'], timeout=90)
    return sum(1 for ln in s.splitlines() if re.search(pattern, ln))


def det_port(c):
    if c['port']:
        return c['port']
    rc, s = sh(['ss', '-lntup'])
    m = re.findall(r':(\d{4,5})\s', s)
    conf = Path(c['conf'])
    if conf.is_file():
        t = conf.read_text(encoding='utf-8', errors='replace')
        m2 = re.findall(r'^(?:listen|server_port)\s*=\s*(\d+)', t, re.M)
        if m2:
            return m2[0]
    for p in m:
        if p in ('49989', '49999'):
            return p
    return ''


