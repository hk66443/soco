def svc_props(svc, *props):
    """按 props 顺序返回值。
    ⚠ systemctl show 的**输出顺序不保证**与 -p 的书写顺序一致（曾把 NRestarts 的 0
    当成 ActiveState 报成「启动失败 FAIL 0」），所以用 name=value 形式解析后按名取值。
    """
    args = ['systemctl', 'show', svc]
    for prop in props:
        args += ['-p', prop]
    vals = {}
    for ln in out(args).splitlines():
        if '=' in ln:
            k, v = ln.split('=', 1)
            vals[k.strip()] = v.strip()
    return [vals.get(p, '') for p in props]


def journal(svc, since='-10min', timeout=90):
    return sh(['journalctl', '-u', svc, '--since', since, '-o', 'cat'], timeout=timeout)[1]


def service_start_epoch(svc):
    """本次服务启动的 epoch 秒；取不到返回 None。

    只认「本次启动之后写的」日志 —— soga 的日志文件按天切分，重启不重写文件，
    旧文件里的 `current user num: 498` 会被当成当前值（ARM 上实测 498 vs 面板 297 的假告警）。
    """
    rc, s = sh(['systemctl', 'show', svc, '-p', 'ActiveEnterTimestampMonotonic', '--value'])
    try:
        mono = int((s or '').strip())
    except ValueError:
        return None
    if mono <= 0:
        return None
    try:
        now_mono = float(Path('/proc/uptime').read_text().split()[0])
    except OSError:
        return None
    return time.time() - (now_mono - mono / 1_000_000.0)


def _line_epoch(ln):
    """日志行时间戳 → epoch。支持 soco 自己的 `2026/11/27 03:35:24` 与 syslog 的 `Nov 27 03:35:24`。

    解析不出来返回 None（宁可不采信，也不把历史数字当当前值）。
    """
    m = re.match(r'(\d{4})[/-](\d{1,2})[/-](\d{1,2})[ T](\d{1,2}):(\d{2}):(\d{2})', ln)
    if m:
        try:
            return time.mktime((int(m.group(1)), int(m.group(2)), int(m.group(3)),
                                int(m.group(4)), int(m.group(5)), int(m.group(6)), 0, 0, -1))
        except (ValueError, OverflowError):
            return None
    m = re.match(r'([A-Z][a-z]{2}) +(\d{1,2}) (\d{2}):(\d{2}):(\d{2})', ln)
    if m:
        try:
            mon = time.strptime(m.group(1), '%b').tm_mon
            now = time.localtime()
            y = now.tm_year - (1 if mon > now.tm_mon else 0)
            return time.mktime((y, mon, int(m.group(2)), int(m.group(3)),
                                int(m.group(4)), int(m.group(5)), 0, 0, -1))
        except (ValueError, OverflowError):
            return None
    return None


def _user_num_from_logfiles(svc='soco'):
    """从 soco 自己的文件日志里取最后一条 current user num（**只作历史参考**）。
    log_level=error 时 journal 里不再有 INFO 行（这是刻意的，只记错误），
    但文件日志（/etc/soga/{soga,so}-*.log）里可能还留着历史快照。

    ⚠ 只认**本次启动之后**写的行：
      · 文件 mtime 早于本次启动 → 整份跳过（soga 按天切分，重启不重写）；
      · 行首时间戳必须能解析且不早于本次启动 → 否则跳过（syslog 副本 daemon.log 会被 mtime
        骗过：文件一直在写，但里面那条 498 是昨天的）。
    `/var/log` 里的 syslog 转发副本（daemon.log / syslog）不采信——那是同一批行的副本，
    出现过「daemon.log 里 Nov 26 03:03:37 的 498 被当成当前人数」的假告警。
    """
    start_epoch = service_start_epoch(svc)
    for d in ('/etc/soga', '/usr/local/soco'):
        p = Path(d)
        if not p.is_dir():
            continue
        files = [f for f in p.glob('*.log') if f.is_file()]
        files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
        for f in files[:4]:
            try:
                # 本次启动之后都没再写过的文件 = 历史文件，里面的数字不是当前值
                if start_epoch is not None and f.stat().st_mtime < start_epoch - 5:
                    continue
                lines = f.read_text(encoding='utf-8', errors='replace').splitlines()[-6000:]
            except OSError:
                continue
            # 本次进程的起点：最后一条 init log file（没有就整份都算）
            start = 0
            for i, ln in enumerate(lines):
                if 'init log file' in ln:
                    start = i
            hits = []
            for ln in lines[start:]:
                m = re.search(r'current user num:\s*(\d+)', ln)
                if not m:
                    continue
                ts_epoch = _line_epoch(ln)
                if start_epoch is not None:
                    if ts_epoch is None or ts_epoch < start_epoch - 60:
                        continue        # 时间不明或早于本次启动：不采信
                hits.append((m.group(1), ln[:19]))
            if hits:
                n, ts = hits[-1]
                return n, str(f), ts
    return None, None, None


def last_user_num(svc, with_src=False):
    """本地用户数：journal（log_level=info 时）→ 文件日志兜底 → '-'。

    with_src=True 时返回 (人数, 来源说明)。
    """
    nums = re.findall(r'current user num:\s*(\d+)', journal(svc, '-20min'))
    if nums:
        return (nums[-1], 'journal（实时）') if with_src else nums[-1]
    n, f, mt = _user_num_from_logfiles(svc)
    if n:
        return (n, '日志文件 %s 里 %s 的值' % (f, mt)) if with_src else n
    return ('-', '不可读：log_level=error 不写 INFO 行，要看人数把 log_level 设为 info') \
        if with_src else '-'


def last_routes_line(svc):
    # journalctl --grep 由 systemd 侧过滤（注意：不要加 -n，-n 在过滤前截断，会漏）
    rc, s = sh(['journalctl', '-u', svc, '--grep', 'load routes config', '-o', 'cat'],
               timeout=120)
    if rc != 0 or 'load routes config' not in s:
        s = sh(['journalctl', '-u', svc, '-n', '4000', '-o', 'cat'], timeout=90)[1]
        s = '\n'.join(l for l in s.splitlines() if 'load routes config' in l)
    for ln in reversed(s.strip().splitlines()):
        if 'load routes config' in ln:
            return ln.split('load routes config')[-1].strip()[:90]
    return '-'


def resolve_pkg(c):
    """项目目录：配置里的 pkg 可能过时（比如用 SO_DEST 装到别处），以实际位置为准。"""
    here = Path(__file__).resolve().parent.parent
    for p in (Path(c['pkg']), here, Path('/root/so')):
        if (p / '_ops' / 'probe_many.py').is_file() or (p / 'packaging').is_dir():
            return p
    return Path(c['pkg'])


def probe_script(c):
    """探针脚本：优先用**最新的**一份。

    bin_dir 里的是 install 拷的运行副本，pkg/_ops 里的是随一键命令更新的源码；
    只认 bin_dir 会让「项目已更新但没重新 install」的机器一直跑旧探针（ARM 上实测过）。
    """
    cands = [Path(c['bin_dir']) / 'probe_many.py',
             resolve_pkg(c) / '_ops' / 'probe_many.py',
             resolve_pkg(c) / 'probe_many.py',
             Path('/root/soco-pkg/probe_many.py')]
    have = [p for p in cands if p.is_file()]
    if not have:
        return None
    try:
        return max(have, key=lambda p: p.stat().st_mtime)
    except OSError:
        return have[0]


def elf_machine(path):
    """ELF e_machine：62 = x86-64，183 = AArch64。"""
    try:
        b = Path(path).read_bytes()[:20]
    except OSError:
        return None
    if b[:4] != b'\x7fELF':
        return None
    return int.from_bytes(b[18:20], 'little')


