def panel_users(c):
    """面板 /UniProxy/user 条数（None = 取不到）。"""
    conf = Path(c['conf'])
    if not conf.is_file():
        return None
    url, nid, key = key_of(conf, 'webapi_url'), key_of(conf, 'node_id'), key_of(conf, 'webapi_key')
    if not (url and nid and key):
        return None
    st = key_of(conf, 'server_type', 'vless')
    nt = {'ss': 'shadowsocks', 'vless': 'vless', 'vmess': 'vmess'}.get(st, st)
    rc, s = sh(['curl', '-sS', '--max-time', '20', '%s/api/v1/server/UniProxy/user'
                '?node_id=%s&node_type=%s&token=%s' % (url, nid, nt, key)])
    try:
        return len(json.loads(s)['users'])
    except Exception:
        return None


def panel_config(conf_path):
    """按**指定配置文件**（主配置或实例配置）向面板拉节点 config；拉不到返回 None。

    实例部署必须靠它拿到 server_port——拉不到就等于「不知道实例该监听哪个端口」，
    以前会退化成用主实例端口判断，于是面板不可达时实例照样被报成 PASS（僵尸进程 + 白占内存）。
    """
    conf = Path(conf_path)
    if not conf.is_file():
        return None
    url, nid, key = key_of(conf, 'webapi_url'), key_of(conf, 'node_id'), key_of(conf, 'webapi_key')
    if not (url and nid and key):
        return None
    st = key_of(conf, 'server_type', 'vless')
    nt = {'ss': 'shadowsocks', 'vless': 'vless', 'vmess': 'vmess'}.get(st, st)
    rc, s = sh(['curl', '-sS', '--max-time', '20', '%s/api/v1/server/UniProxy/config'
                '?node_id=%s&node_type=%s&token=%s' % (url.rstrip('/'), nid, nt, key)], timeout=45)
    if rc != 0:
        return None
    try:
        d = json.loads(s)
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def det_port(c):
    p = port_of_service(c['service'])            # 以主进程实际监听为准
    if p:
        return p
    if c['port']:
        return c['port']
    conf = Path(c['conf'])
    if conf.is_file():
        m = re.findall(r'^(?:listen_port|local_port|server_port|listen)\s*=\s*(\d+)',
                       conf.read_text(errors='replace'), re.M)
        if m:
            return m[0]
    for p in re.findall(r':(\d{4,5})\s', out(['ss', '-lnt'])):
        if p in ('49989', '49999'):
            return p
    return ''


def port_of_service(svc):
    """业务端口：按主进程 PID 反查监听套接字（比读配置可靠）。"""
    pid = main_pid(svc)
    if pid in ('', '0'):
        return ''
    for ln in out(['ss', '-lntup']).splitlines():
        if 'pid=%s,' % pid in ln:
            m = re.search(r':(\d{4,5})\s', ln)
            if m:
                return m.group(1)
    return ''


def human_size(path):
    """文件大小的可读字符串；不依赖外部 du（最小化镜像里不一定有），文件不存在返回 '-'。"""
    p = Path(path)
    try:
        n = float(p.stat().st_size)
    except (OSError, ValueError):
        return '-'
    for unit in ('B', 'K', 'M', 'G'):
        if n < 1024 or unit == 'G':
            return ('%d%s' % (round(n), unit)) if unit == 'B' else ('%.1f%s' % (n, unit))
        n /= 1024.0
    return '-'


def key_of(path, name, default=''):
    try:
        for ln in Path(path).read_text(errors='replace').splitlines():
            if ln.split('=', 1)[0].strip() == name:
                return ln.split('=', 1)[1].strip()
    except OSError:
        pass
    return default


def level_of(path):
    """配置里的日志级别（只认 error/info，其它值一律当 error）。"""
    v = key_of(path, 'log_level', FIXED['log_level'])
    return v if v in LOG_LEVELS else FIXED['log_level']


def reuse_or_new_soga_key(a, conf_path):
    """soga_key 幂等：--soga-key > 已有配置里的值 > 随机。

    以前每次 install 都随机生成一个：同一台机器重跑一次修复就换掉授权密钥，
    面板侧若也跟着存了这串（部分机场会比对），修一次就断一次。
    """
    v = (getattr(a, 'soga_key', None) or '').strip()
    if v:
        return v, 'cli'
    old = key_of(conf_path, 'soga_key') if Path(conf_path).is_file() else ''
    if old:
        return old, 'reuse'
    return secrets.token_hex(16), 'auto'


