                'check_interval', 'submit_interval', 'log_level',
                'cert_mode', 'cert_domain', 'cert_file', 'key_file', 'dns_provider')


def conf_template_keys():
    """原版模板里的键，按出现顺序。"""
    return re.findall(r'^([A-Za-z_][A-Za-z0-9_]*)=', SOGA_CONF_TEMPLATE, re.M)


def parse_conf(path):
    """读 KEY=VALUE 配置（忽略注释与空行）。"""
    d = {}
    try:
        for ln in Path(path).read_text(encoding='utf-8', errors='replace').splitlines():
            s = ln.strip()
            if not s or s.startswith('#') or '=' not in s:
                continue
            k, v = s.split('=', 1)
            d[k.strip()] = v.strip()
    except OSError:
        pass
    return d


def write_conf(path, node_id, stype, url, key, soga_key, cert=None, inst_name='main', merge=True,
               log_level=None):
    """写主控/机场配置文件：**结构与原版 soga 2.18.1 模板逐行一致**。

    key      = webapi_key（面板通信密钥，必须与面板一致，客户填）
    soga_key = 授权密钥（本工程已解除授权检查，随便写；控制台随机生成）
    cert     = {'mode','domain','cert_file','key_file','dns_provider'}；非 TLS 或 panel 模式时可为空
    merge    = 文件已存在时保留客户的既有配置：可选键（dy_limit/redis_ip_limit/…）沿用旧值，
               模板之外的键原样追加到末尾 —— 客户在原版 soga 上开过的功能不会因为重装丢失
    """
    path = Path(path)
    vals = dict(CONF_OPTIONAL)
    vals.update({
        'type': FIXED['type'], 'api': FIXED['api'],
        'server_type': stype, 'node_id': node_id, 'soga_key': soga_key,
        'webapi_url': url, 'webapi_key': key,
        'check_interval': FIXED['check_interval'],
        'submit_interval': FIXED['submit_interval'],
        'log_level': log_level if log_level in LOG_LEVELS else FIXED['log_level'],
        'cert_mode': '', 'cert_domain': '', 'cert_file': '', 'key_file': '', 'dns_provider': '',
    })
    cmode = (cert or {}).get('mode') or ''
    if cmode == 'panel':
        vals.update({'cert_mode': 'panel', 'cert_domain': cert.get('domain') or ''})
    elif cmode:
        vals.update({'cert_mode': cmode,
                     'cert_domain': cert.get('domain') or '',
                     'cert_file': cert.get('cert_file') or '',
                     'key_file': cert.get('key_file') or '',
                     'dns_provider': cert.get('dns_provider') or ''})

    extras = []
    if merge and path.is_file():
        old = parse_conf(path)
        tkeys = set(conf_template_keys())
        for k in CONF_OPTIONAL:                 # 客户已开的功能：保留原值
            if old.get(k, '') != '':
                vals[k] = old[k]
        if log_level not in LOG_LEVELS:
            # 没显式指定就沿用客户已选的级别：info 不会被一次重装静默压回 error
            if old.get('log_level', '') in LOG_LEVELS:
                vals['log_level'] = old['log_level']
        for k, v in old.items():                # 模板之外的键：原样带走
            if k not in tkeys and k not in CONF_MANAGED:
                extras.append('%s=%s' % (k, v))

    body = SOGA_CONF_TEMPLATE.format(**vals)
    if extras:
        body += ('\n# 以下键不在原版模板里（沿用你原有配置，install 不会丢）\n'
                 + '\n'.join(extras) + '\n')
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body, encoding='utf-8')
    os.chmod(path, 0o600)
    return path


def self_cert(cert_dir, domain):
    """生成自签证书（10 年），返回 (cert_file, key_file)。"""
    cert_dir = Path(cert_dir)
    cert_dir.mkdir(parents=True, exist_ok=True)
    crt, key = cert_dir / 'cert.pem', cert_dir / 'key.pem'
    if crt.is_file() and key.is_file():
        return str(crt), str(key)
    rc, s = sh(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3650',
                '-keyout', str(key), '-out', str(crt),
                '-subj', '/CN=%s' % (domain or 'localhost'),
                '-addext', 'subjectAltName=DNS:%s' % (domain or 'localhost')])
    if rc != 0:
        raise RuntimeError('生成自签证书失败: %s' % s[:120])
    os.chmod(key, 0o600)
    return str(crt), str(key)


def preflight(ctx=None, need_bin=True, allow_missing=False):
    c = ctx or cfg_load()
    probs = []
    if not is_root():
        probs.append('需要 root 执行')
    for tool in ('systemctl', 'journalctl', 'ss', 'curl', 'python3', 'openssl'):
        if not shutil.which(tool):
            probs.append('缺少命令 %s' % tool)
    if not shutil.which('nft'):
        probs.append('缺少 nft（闸门转发需要）')
    if need_bin:
        bd = Path(c['bin_dir'])
        for n in ('soco', 'libsoco.so'):
            f = bd / n
            if not f.is_file():
                if not allow_missing:
                    probs.append('缺二进制 %s（见 DEPLOY.md §2）' % f)
                continue
            em = elf_machine(f)
            want = ARCH_EM.get(arch())
            if em and want and em != want:
                probs.append('%s 架构不符：这是 %s 的二进制，当前机器是 %s'
                             % (n, 'arm64' if em == 183 else 'amd64' if em == 62 else 'em%d' % em, arch()))
    return probs


def preflight_warn(ctx):
    """不阻断安装、但必须告知的缺项。"""
    warns = []
    if probe_client(ctx) is None:
        warns.append('缺探测客户端 sing-box-probe（probe / doctor 会用到，见 DEPLOY.md §2.1）')
    if probe_script(ctx) is None:
        warns.append('缺 probe_many.py（install 会从项目 _ops/ 拷，拷不到就手放）')
    return warns


def deploy(ctx, node_id, stype, url, key, soga_key='', cert=None, name='main', yes=False, dry=False,
           probe_after=True, key_src='panel', log_level=None):
    """幂等部署 / 修复。name='main' 部署主实例，其余部署 soco@<name> 实例。

    key      = webapi_key（面板通信密钥，客户给，必须与面板一致）
    soga_key = 授权密钥（随便写；控制台随机生成）
    cert     = {'mode','domain','cert_file','key_file','dns_provider'}（非 TLS 可为 None）
    log_level= error|info（None = 沿用已有配置里的级别，没有就 error）
    """
    n_steps = 7
    main_inst = (name == 'main')
    bd = Path(ctx['bin_dir'])
    pkg = resolve_pkg(ctx)
    conf_path = Path(ctx['conf']) if main_inst else Path(ctx['inst_dir']) / ('%s.conf' % name)
    lvl = log_level if log_level in LOG_LEVELS else level_of(conf_path)
    conf_existed = conf_path.exists()
    svc = ctx['service'] if main_inst else '%s@%s' % (ctx['service'], name)
    soga_key = soga_key or secrets.token_hex(16)
    cert = cert or {}
    key_note = {'panel': '（面板给的那串）',
                'reuse': '（沿用已有配置，未改动）',
                'auto': '（本机随机生成，需填到面板同一串）'}.get(key_src, '')

    head('部署 %s  %s' % (name, '(dry-run)' if dry else ''))
    kv('架构', arch())
    kv('节点 ID', node_id)
    kv('协议', stype + ('（TLS）' if stype in TLS_PROTOS else ''))
    kv('面板', url)
    kv('配置', str(conf_path))
    kv('单元', svc + '.service')
    kv('面板密钥 webapi_key', key[:8] + '…' + key[-4:] + '  ' + key_note)
    kv('授权密钥 soga_key', soga_key[:8] + '…（本工程不校验，随机即可）')
    if cert.get('mode'):
        kv('证书', '%s %s' % (cert['mode'], cert.get('domain') or ''))

    i = 0
    i += 1
    step(i, n_steps, '环境预检', 'run')
    probs = preflight(ctx, need_bin=True, allow_missing=dry)
    if probs:
        step(i, n_steps, '环境预检', 'fail', '; '.join(probs))
        return 2
    step(i, n_steps, '环境预检', 'ok')
    for w in preflight_warn(ctx):
        warn(w)

    i += 1
    step(i, n_steps, '目录与二进制', 'run')
    if not dry:
        for d in (bd, bd / 'licence', Path(ctx['inst_dir'])):
            d.mkdir(parents=True, exist_ok=True)
        os.chmod(bd / 'soco', 0o755)
        os.chmod(bd / 'libsoco.so', 0o600)
        for src, dst, mode in ((pkg / '_ops' / 'probe_many.py', bd / 'probe_many.py', 0o755),
                               (pkg / 'packaging' / 'soco-watchdog.py', bd / 'soco-watchdog.py', 0o755),
                               (pkg / 'packaging' / 'routes-guard.py', bd / 'routes-guard.py', 0o755),
                               (pkg / 'amd64' / 'src' / 'licence-sink.py', bd / 'licence' / 'sink.py', 0o755)):
            if src.is_file():
                shutil.copy2(src, dst)
                os.chmod(dst, mode)
        if pkg != Path(ctx['pkg']):
            ctx['pkg'] = str(pkg)      # 记住实际项目目录，后续命令都好使
    step(i, n_steps, '目录与二进制', 'ok', 'soco %s' % human_size(bd / 'soco'))

    i += 1
    step(i, n_steps, '写入配置（主控信息 + 证书）', 'run')
    if dry:
        step(i, n_steps, '写入配置（主控信息 + 证书）', 'skip', 'dry-run')
    else:
        if cert.get('mode') == 'self':
            cf, kf = self_cert(bd / 'cert', cert.get('domain') or '')
            cert['cert_file'], cert['key_file'] = cf, kf
            cert['mode'] = 'file'
            ok('自签证书 → %s' % cf)
        elif cert.get('mode') == 'file':
            for p in (cert.get('cert_file'), cert.get('key_file')):
                if not p or not Path(p).is_file():
                    step(i, n_steps, '写入配置（主控信息 + 证书）', 'fail', '证书文件不存在：%s' % p)
                    return 3
        bak = None
        if conf_path.exists():
            bak = Path(str(conf_path) + '.bak.%s' % time.strftime('%Y%m%d%H%M%S'))
            warn('%s 已存在，先备份 %s，再按原版模板合并写入' % (conf_path, bak.name))
            shutil.copy2(conf_path, bak)
        write_conf(conf_path, node_id, stype, url, key, soga_key, cert, log_level=lvl)
        kept = [k for k in CONF_OPTIONAL
                if bak and parse_conf(bak).get(k, '') not in ('', CONF_OPTIONAL[k])]
        step(i, n_steps, '写入配置（主控信息 + 证书）', 'ok',
             '原版模板结构 %d 键' % len(conf_template_keys())
             + (', 保留自定义 %d 项' % len(kept) if kept else '')
             + (', cert_mode=%s' % cert['mode'] if cert.get('mode') else ''))

    i += 1
    step(i, n_steps, '授权 sink + hosts + nft', 'run')
    if dry:
        step(i, n_steps, '授权 sink + hosts + nft', 'skip', 'dry-run')
    else:
        scrt, skey = bd / 'licence' / 'cert.pem', bd / 'licence' / 'key.pem'
        if not (scrt.is_file() and skey.is_file()):
            sh(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3',
                '-keyout', str(skey), '-out', str(scrt), '-subj', '/CN=%s' % LICENCE_HOSTS[0],
                '-addext', 'subjectAltName=DNS:%s' % LICENCE_HOSTS[0]])
            os.chmod(skey, 0o600)
        missing = [h for h in LICENCE_HOSTS if h not in read_hosts()]
        if missing:
            try:
                with Path('/etc/hosts').open('a') as f:
                    f.write(''.join('\n127.0.0.1 %s\n' % h for h in missing))
            except OSError as e:
                # 只读 /etc/hosts（容器、immutable 属性）时以前直接 traceback；
                # 这里算「闸门路径没铺好」，明确判失败并说清后果。
                step(i, n_steps, '授权 sink + hosts + nft', 'fail',
                     '/etc/hosts 不可写：%s（600 s 闸门不会被压制）' % e)
                return 4
        # sink 38443 的真实验证放在下一步（systemd 单元）之后：那一步才写单元并启动 sink。
        # 这里曾直接读「后一步才赋值」的 sink_up，导致首装/修复一律在 [4/7] 抛
        # UnboundLocalError —— 单元永远写不出来、服务永远起不来（2026-11-27 现网事故）。
        step(i, n_steps, '授权 sink + hosts + nft', 'ok',
             'hosts +%d（sink 38443 与 nft dnat 在下一步启动并验证）' % len(missing))

    i += 1
    step(i, n_steps, 'systemd 单元', 'run')
    if dry:
        step(i, n_steps, 'systemd 单元', 'skip', 'dry-run')
    else:
        # 实例部署的前置硬校验：必须能从面板拉到节点 config（server_port 是实例的唯一端口来源）。
        # 主实例允许面板暂时抽风（已有 listener 不受影响），实例不行——否则会起一个没端口的僵尸进程。
        if not main_inst:
            pc = panel_config(conf_path)
            if not pc or not pc.get('server_port'):
                step(i, n_steps, 'systemd 单元', 'fail',
                     '面板接口拉不到节点 config / server_port（实例不会监听端口）')
                warn('检查 webapi_url / webapi_key / node_id（%s）' % conf_path)
                warn('若确认不要再这个实例：so-console inst remove %s --yes' % name)
                if not conf_existed:
                    try:
                        conf_path.unlink(missing_ok=True)   # 没起过服务的失败部署不留半截配置
                    except OSError:
                        pass
                return 3
        us = Path('/etc/systemd/system')
        # journal 里的 INFO 行由 systemd 侧过滤：log_level=info 时 LogLevelMax 必须跟着放开，
        # 否则 even with info，console 也读不到 current user num（本地人数永远 '-'）
        log_max = 'warning' if lvl == 'error' else 'info'
        for uname, tpl in UNITS.items():
            (us / uname).write_text(
                tpl.format(bin_dir=ctx['bin_dir'], inst_dir=ctx['inst_dir'], log_max=log_max),
                encoding='utf-8')
        sh(['systemctl', 'daemon-reload'])
        sh(['systemctl', 'enable', 'soco-licence-sink.service', 'soco-sink-redirect.service'])
        # 先 restart 再 start：sink.py 可能刚被更新（修 bug 后重跑 install），
        # 只 start 的话 systemd 认为它已在跑，新代码不会生效（曾因此 38443 一直不监听）
        sh(['systemctl', 'restart', 'soco-licence-sink.service'])
        sh(['systemctl', 'start', 'soco-sink-redirect.service'])
        # 等 sink 真的把 38443 绑上。首次安装时 unit 刚 enable，restart 可能返回非 0
        # （Job for … canceled / unit not found 的竞态），所以「等不到就再 restart 一次」，
        # 最多试 3 轮，每轮等 8 s —— 不能只看一次就判死。
        sink_up = False
        for attempt in range(3):
            for _ in range(10):
                time.sleep(0.8)
                if ':38443' in out(['ss', '-lnt']):
                    sink_up = True
                    break
            if sink_up:
                break
            if attempt < 2:
                sh(['systemctl', 'daemon-reload'])
                sh(['systemctl', 'restart', 'soco-licence-sink.service'])
        if main_inst:
            sh(['systemctl', 'enable', 'soco-watchdog.service'])
            sh(['systemctl', 'enable', svc + '.service'])
            sh(['systemctl', 'restart', svc + '.service'])
            sh(['systemctl', 'start', 'soco-watchdog.service'])
        else:
            sh(['systemctl', 'enable', svc + '.service'])
            sh(['systemctl', 'restart', svc + '.service'])
        cfg_save(ctx)
        if sink_up:
            step(i, n_steps, 'systemd 单元', 'ok', '5 个单元 / daemon-reload / sink 38443')
        else:
            failed_sink = True
            step(i, n_steps, 'systemd 单元', 'fail',
                 '单元已写入，但 sink :38443 未监听（已重试 3 轮）')
            warn('sink 服务 %s，但 38443 没在监听 —— 检查 sink.py 是否忽略 --listen'
                 % svc_state('soco-licence-sink'))
            warn('看日志： so-console logs soco-licence-sink 40')

    i += 1
    step(i, n_steps, '启动与状态', 'run')
    if dry:
        step(i, n_steps, '启动与状态', 'skip', 'dry-run')
    else:
        # 等「业务端口真的 LISTEN」而不是「ss 有输出」（后者恒真，曾导致刚重启就判成功、
        # 紧接着 probe 全部握手失败）。就绪时间实测 10–19 s，最多等 60 s。
        port, waited, own = '', 0.0, ''
        # 实例的期望端口只来自它自己的面板 config；主实例才允许回落到「主服务实际监听/console.conf」。
        expect = ''
        if not main_inst:
            expect = str((panel_config(conf_path) or {}).get('server_port') or '')
        for _ in range(40):
            time.sleep(1.5)
            waited += 1.5
            if svc_state(svc) != 'active':
                continue
            if main_inst:
                p = port_of_service(svc) or det_port(ctx)
                if p and (':%s' % p) in out(['ss', '-lnt']):
                    port = p
                    break
            else:
                # 实例必须「自己的 PID」在监听：以前只看「expect 端口有人听」，
                # 实例把端口配成和主实例一样时会拿主实例的 listener 判 PASS。
                p = port_of_service(svc)
                if p:
                    own = port = p
                    break
                port = expect
        st, rs = svc_props(svc, 'ActiveState', 'NRestarts')
        pid = main_pid(svc)
        listening = bool(own) if not main_inst else (bool(port) and (':%s' % port) in out(['ss', '-lnt']))
        if st == 'active' and listening:
            step(i, n_steps, '启动与状态', 'ok', 'pid=%s restarts=%s port=%s 就绪 %.0fs'
                 % (pid, rs, port, waited))
        elif st == 'active' and not main_inst:
            start_failed = True
            busy = expect and (':%s' % expect) in out(['ss', '-lnt'])
            step(i, n_steps, '启动与状态', 'fail',
                 '实例没监听自己的端口 %s%s（%.0fs）'
                 % (expect or '-',
                    '；该端口已被别的进程占用（检查面板给这个节点的 server_port）' if busy else '',
                    waited))
            warn('看日志： so-console logs %s 120' % svc)
        elif st == 'active':
            start_failed = True
            step(i, n_steps, '启动与状态', 'fail', 'active 但 :%s 未监听（%.0fs）' % (port or '-', waited))
            warn('看日志： so-console logs %s 120' % svc)
        else:
            start_failed = True
            step(i, n_steps, '启动与状态', 'fail', st or 'unknown')
            warn('看日志： so-console logs %s 120' % svc)

    i += 1
    failed = 0
    if locals().get('failed_sink'):
        failed += 1
    if locals().get('start_failed'):
        # [6/7] 失败（服务没起来 / 实例没监听自己的端口）以前不计数，部署照样返回 0
        failed += 1
    step(i, n_steps, '真实握手验证', 'run')
    if dry or not probe_after:
        step(i, n_steps, '真实握手验证', 'skip', 'dry-run' if dry else 'skipped')
    else:
        script = bd / 'probe_many.py'
        if not script.is_file():
            step(i, n_steps, '真实握手验证', 'fail', 'probe_many.py 缺失')
            failed += 1
        elif probe_client(ctx) is None:
            # 缺 sing-box 客户端：明确说清「装什么、怎么装」，不要只丢一个 FileNotFoundError
            step(i, n_steps, '真实握手验证', 'skip', '缺 sing-box-probe（不影响服务运行）')
            warn('真实握手需要 sing-box 客户端，装一下再重跑 install 即可验证：')
            warn('  curl -fsSL -o /tmp/sb.tgz https://github.com/SagerNet/sing-box/releases/download/'
                 'v1.14.5/sing-box-1.14.5-linux-%s.tar.gz' % ('arm64' if arch() == 'arm64' else 'amd64'))
            warn('  tar xzf /tmp/sb.tgz -C /tmp && install -m 755 /tmp/sing-box-*/sing-box '
                 '%s/sing-box-probe' % ctx['bin_dir'])
            warn('（服务本身已起来，这一步只是「验证」；跳过不算失败）')
        else:
            # 重启后第一轮可能还在拉用户（实测有 1/3 的假失败），失败就等 15 s 再来一轮
            rc, s, line, tries = 1, '', [], 0
            for tries in (1, 2):
                if tries > 1:
                    warn('首轮握手未全通过，等 15 s 复测（重启后仍在拉用户）')
                    time.sleep(15)
                # 实例验证必须用**实例自己的配置**拉用户/端口：probe_many.py 默认读主配置，
                # 不传 SO_PROBE_CONF 会把「主实例通」当成「实例通」（之前在实例部署里误判 PASS）
                probe_env = None if main_inst else {'SO_PROBE_CONF': str(conf_path)}
                rc, s = sh(['python3', script, '3', '1,2,3'], timeout=300, env=probe_env)
                line = [l for l in s.splitlines() if l.startswith('TOTAL')]
                if rc == 0:
                    break
            if rc == 0:
                step(i, n_steps, '真实握手验证', 'ok',
                     (line[0] if line else '3/3') + ('（第 %d 轮）' % tries if tries > 1 else ''))
            else:
                step(i, n_steps, '真实握手验证', 'fail', (line[0] if line else s.strip()[-60:]))
                failed += 1

    head('完成')
    kv('服务', '%s.service (%s)' % (svc, svc_state(svc)))
    kv('配置文件', str(conf_path))
    kv('面板', url)
    kv('面板密钥 webapi_key', '%s  %s（必须与面板一致）' % (key, key_note))
    kv('授权密钥 soga_key', '%s（本工程不校验，可随意）' % soga_key)
    if cert.get('mode') and cert['mode'] != 'panel':
        kv('证书', '%s / %s' % (cert.get('cert_file', '-'), cert.get('key_file', '-')))
    elif cert.get('mode') == 'panel':
        kv('证书', '由面板下发（cert_mode=panel）')
    kv('下一步', 'so-console status / probe 3 / doctor')
    if key_src == 'auto':
        warn('面板密钥是本机随机生成的：要么把它填进面板的 webapi_key（与 soga_key 同一串），'
             '要么用 --webapi-key <面板给的串> 重跑一次')
    elif key_src == 'panel':
        ok('webapi_key 用的是面板那串（面板与节点必须一致，否则拉不到用户）')
    if cert.get('mode') == 'self':
        warn('自签证书只适合客户端「跳过校验」的场景；要正式证书用 --cert-mode http|dns')
    if failed:
        warn('%d 个步骤未通过，按上面的提示处理后重跑 install（幂等）' % failed)
    return 0 if not failed else 1


def ask_cert(stype, preset_mode=None, preset_domain=''):
    """按协议问证书（TLS 协议必问；ss 不问；vless 默认面板 REALITY）。"""
    if stype == 'ss':
        return None
    head('证书（%s 需要 TLS）' % stype)
    for k in sorted(CERT_MODES):
        kv(k, CERT_MODES[k][1])
    default = '1' if stype in ('vless', 'vmess') else '2'
    pick = preset_mode or ask('证书方式', default=default, valid=r'[1-5]')
    mode = CERT_MODES[pick][0]
    cert = {'mode': mode, 'domain': preset_domain, 'cert_file': '', 'key_file': '',
            'dns_provider': ''}
    if mode == 'panel':
        cert['domain'] = cert['domain'] or ask('域名（面板证书用的 SNI，可回车跳过）',
                                               default='', valid=r'.*')
        ok('证书由面板下发，节点侧不写 cert_file')
        return cert
    cert['domain'] = cert['domain'] or ask('证书域名（SNI）', valid=r'[A-Za-z0-9.-]{4,}',
                                            hint='例如 node.example.com')
    if mode == 'self':
        ok('本机自签：装的时候生成 cert/key 到 %s/cert/' % cfg_load()['bin_dir'])
    elif mode == 'file':
        cert['cert_file'] = ask('证书文件路径（fullchain）', valid=r'/\S+',
                                 hint='绝对路径，例如 /etc/ssl/fullchain.pem')
        cert['key_file'] = ask('私钥文件路径', valid=r'/\S+',
                                hint='绝对路径，例如 /etc/ssl/privkey.pem')
    elif mode == 'http':
        ok('ACME HTTP-01：域名 %s 的 80 端口必须能从公网访问，soga 自己申请' % cert['domain'])
        cert['cert_file'] = '/usr/local/soco/cert/cert.pem'
        cert['key_file'] = '/usr/local/soco/cert/key.pem'
    elif mode == 'dns':
        cert['dns_provider'] = ask('DNS 提供商（如 cloudflare / aliyun / dnspod）',
                                    valid=r'[a-z0-9_-]{3,}')
        cert['cert_file'] = '/usr/local/soco/cert/cert.pem'
        cert['key_file'] = '/usr/local/soco/cert/key.pem'
        warn('DNS-01 的 API 凭证放在环境变量里（soga 读取），不会写进配置文件')
    return cert


def wizard_target(ctx):
    """交互式收集：节点 ID / 协议 / 面板地址 / 面板通信密钥（+ TLS 协议再问证书）。"""
    head('安装向导  面板上的四项')
    node_id = ask('节点 ID', valid=r'\d+', hint='只能是数字')
    say('  协议：')
    for k in sorted(PROTOS):
        kv('  %s' % k, PROTOS[k][1])
    pick = ask('选择', default='1', valid=r'[1-6]')
    stype = PROTOS[pick][0]
    url = ask('面板地址', default='https://', valid=r'https?://\S+',
              hint='形如 https://panel.example.com')
    url = url.rstrip('/')
    say('  webapi_key = 面板节点详情里那串「通信密钥」，必须与面板一致（不能随机）')
    key = ask('面板密钥 webapi_key', valid=r'\S{6,}', allow_empty=True,
              hint='粘贴面板里的那串（至少 6 位、无空格）；直接回车 = 本机随机生成，装完再回填面板')
    cert = ask_cert(stype)
    say('')
    kv('固定：type', '%s / api=%s' % (FIXED['type'], FIXED['api']))
    kv('固定：间隔', 'pull/push %ss' % FIXED['check_interval'])
    kv('固定：日志', 'log_level=%s（只记错误；要看本地人数就加 --log-level info）' % FIXED['log_level'])
    kv('固定：soga_key', '随机生成（本工程不校验授权）')
    kv('固定：闸门', 'hosts + 本地 sink(38443) + nft dnat')
    return node_id, stype, url, key, cert


# ══════════════════════════════════════════════════════════════ commands
def cmd_install(c, a):
    wizard_key, cert = '', None
    lk = deploy_lock()
    if lk is None:
        bad('另一个 so-console 正在部署（%s），等它结束再试一次' % DEPLOY_LOCK)
        return 2
    has_args = bool(getattr(a, 'node_id', None) and getattr(a, 'url', None))
    if not has_args and not sys.stdin.isatty():
        # 管道 / CI / `curl … | bash` 场景没有 TTY：明确告知怎么给参数，别让向导读 EOF
        bad('非交互模式必须给 --node-id 与 --url；'
            '例：so-console install --node-id 12 --type ss --url https://panel.example.com '
            '--webapi-key <面板的 webapi_key>')
        return 2
    if has_args:
        node_id, url = a.node_id, a.url.rstrip('/')
        stype = getattr(a, 'stype', None) or ('vless' if arch() == 'arm64' else 'ss')
        if stype in TLS_PROTOS and not getattr(a, 'cert_mode', None):
            # vmess/trojan/anytls/hysteria 必须有证书；以前非交互不给 --cert-mode 也照样写配置，
            # 装完 soco 起不来（或裸跑），要人去猜原因。vless 走面板 REALITY，不算在内。
            bad('%s 需要证书：加 --cert-mode panel|self|file|http|dns'
                % stype)
            warn('例：--cert-mode self（本机自签，最快能用）｜--cert-mode http --cert-domain node.example.com')
            return 2
        cert = cert_from_args(a, stype, c)
    else:
        node_id, stype, url, wizard_key, cert = wizard_target(c)
    name = getattr(a, 'name', None) or 'main'
    # 实例名不能等于主配置名：`--name soga` / `inst new soga` 会写到 /etc/soga/soga.conf，
    # 把主实例的配置覆盖掉；同一份配置还会被 soco 与 soco@soga 两个进程同时读（抢端口）。
    main_stem = Path(c['conf']).stem
    if name != 'main' and name in (main_stem, 'soga', 'so'):
        bad('实例名不能是主配置名（%s）；换一个，例如 jp1' % main_stem)
        return 2
    conf_path = Path(c['conf']) if name == 'main' else Path(c['inst_dir']) / ('%s.conf' % name)
    # 面板密钥优先级：--webapi-key > 向导里贴的 > 已有配置沿用 > 本机随机（并提示回填面板）
    key = getattr(a, 'webapi_key', None) or wizard_key or ''
    key_src = 'panel' if key else ''
    if not key and conf_path.is_file():
        old = key_of(conf_path, 'webapi_key')
        if old:
            key, key_src = old, 'reuse'
            ok('检测到已有配置，沿用原 webapi_key（重跑不会换 key）')
    if not key:
        key, key_src = secrets.token_hex(16), 'auto'
    soga_key, sk_src = reuse_or_new_soga_key(a, conf_path)
    if sk_src == 'reuse':
        ok('沿用已有 soga_key（重跑不会换授权密钥）')
    return deploy(c, node_id, stype, url, key, soga_key=soga_key, cert=cert, name=name,
                  dry=getattr(a, 'dry_run', False),
                  probe_after=not getattr(a, 'no_probe', False), key_src=key_src,
                  log_level=getattr(a, 'log_level', None))


def cert_from_args(a, stype, c):
    """非交互：根据 --cert-* 拼证书配置。"""
    mode = getattr(a, 'cert_mode', None)
    if stype == 'ss' or not mode:
        return None
    cert = {'mode': mode, 'domain': getattr(a, 'cert_domain', '') or '',
            'cert_file': getattr(a, 'cert_file', '') or '',
            'key_file': getattr(a, 'cert_key', '') or '',
            'dns_provider': getattr(a, 'dns_provider', '') or ''}
    if mode in ('http', 'dns', 'self') and not cert['cert_file']:
        cert['cert_file'] = str(Path(c['bin_dir']) / 'cert' / 'cert.pem')
        cert['key_file'] = str(Path(c['bin_dir']) / 'cert' / 'key.pem')
    return cert


