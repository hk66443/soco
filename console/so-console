def cfg_load():
    d = dict(DEF)
    if CFG.is_file():
        for line in CFG.read_text(encoding='utf-8').splitlines():
            if '=' in line and not line.lstrip().startswith('#'):
                k, v = line.split('=', 1)
                d[k.strip()] = v.strip()
    return d


def cfg_save(d):
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(''.join('%s=%s\n' % (k, v) for k, v in d.items()), encoding='utf-8')


def sh(cmd, timeout=180, env=None):
    e = None
    if env:
        e = dict(os.environ)
        e.update(env)
    try:
        p = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout, env=e)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except subprocess.TimeoutExpired:
        return 124, 'timeout'
    except FileNotFoundError as e:
        return 127, str(e)


DEPLOY_LOCK = '/tmp/.so-console.deploy.lock'


def deploy_lock():
    """部署互斥：两个 install 同时跑会互相踩（同一批 unit / sink / hosts）。

    成功返回打开的文件对象（进程退出自动释放），拿不到返回 None。
    """
    try:
        import fcntl
        f = open(DEPLOY_LOCK, 'w')
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            f.close()
            return None
        return f
    except Exception:
        return None                            # 没有 fcntl（非 Linux）就不拦


