    head('日志 %s（最后 %s 行）' % (unit, n))
    say(sh(['journalctl', '-u', unit, '-n', n, '-o', 'cat'])[1].rstrip() or '(空)')
    return 0


def cmd_backup(c, a):
    head('备份')
    keep = getattr(a, 'keep', None)
    ts = time.strftime('%Y%m%d-%H%M%S')
    dst = Path('/root/so-backup-%s.tar.gz' % ts)
    with tarfile.open(dst, 'w:gz') as t:
        for p in (c['bin_dir'], c['inst_dir']):
            if Path(p).exists():
                t.add(p)
    ok('%s（%d KB）' % (dst, dst.stat().st_size // 1024))
    if keep:
        olds = sorted(Path('/root').glob('so-backup-*.tar.gz'))
        for old in olds[:-int(keep)] if int(keep) > 0 else []:
            old.unlink(missing_ok=True)
            kv('已清理', old.name)
    left = sorted(Path('/root').glob('so-backup-*.tar.gz'))
    kv('现有备份', '%d 个' % len(left))
    return 0


def cmd_rollback(c, a):
    head('回滚')
    cands = sorted(Path('/root').glob('so-backup-*.tar.gz'))
    if not cands:
        bad('没有备份')
        return 1
    pick = None
    if getattr(a, 'file', None):
        pick = Path(a.file)
    else:
        rows = [[i + 1, p.name, '%d KB' % (p.stat().st_size // 1024)] for i, p in enumerate(cands)]
        table(rows, ['#', '备份', '大小'])
        sel = ask('选择 #（回车取消）', default='', valid=r'\d*')
        if not sel:
            return 0
        pick = cands[int(sel) - 1]
    sh(['systemctl', 'stop', c['service']])
    with tarfile.open(pick, 'r:gz') as t:
        try:
            t.extractall('/', filter='data')
        except TypeError:                     # python < 3.12
            t.extractall('/')
    sh(['systemctl', 'start', c['service']])
    ok('已恢复 %s' % pick.name)
    return cmd_status(c, a)


def cmd_verify(c, _a):
