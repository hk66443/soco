def cmd_backup(c, a):
    head('备份')
    keep = getattr(a, 'keep', None)
    if keep is None:
        # 一份备份 ~70 MB（二进制 82 M + 探针 76 M，压缩后 70 M）。默认只留最近 3 份，
        # 以前默认不清理 —— 客户跑几个月就把 /root 撑满，最后连 install 都写不进。
        keep = '3'
    ts = time.strftime('%Y%m%d-%H%M%S')
    outdir = Path(os.environ.get('SO_BACKUP_DIR') or '/root')
    try:
        outdir.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        bad('备份目录不可写：%s（%s）' % (outdir, e))
        return 1
    dst = outdir / ('so-backup-%s.tar.gz' % ts)
    try:
        free_mb = shutil.disk_usage(str(outdir)).free // (1024 * 1024)
        if free_mb < 200:
            # 一次备份 70–120 MB；/tmp 是 tmpfs 时更容易撞满（实测 AMD /tmp 只有 482 MB）
            warn('备份目录 %s 只剩 %d MB（一次备份 ~70–120 MB）；先清理旧备份或换 SO_BACKUP_DIR'
                 % (outdir, free_mb))
    except OSError:
        pass
    try:
        def _skip(ti):
            # 别把上一次的备份/编译缓存打进新备份：否则每备份一次都变大一截。
            # 注意 `.bak.` 出现在文件名中间（soco-watchdog.py.bak.2026…），不能用 '/.bak.'。
            n = '/' + ti.name.replace('\\', '/').lstrip('/')
            if '__pycache__' in n or '.bak.' in n or n.endswith('.pyc'):
                return None
            # 实例私有日志/缓存目录（/etc/soga/instances/<name>/）不备份：可能很大且可重建。
            # 注意目录条目本身叫 `…/instances`（结尾没有斜杠），所以不能写 '/instances/'。
            if '/instances' in n or '/access_log' in n:
                return None
            return ti

        with tarfile.open(dst, 'w:gz') as t:
            for p in (c['bin_dir'], c['inst_dir']):
                if Path(p).exists():
                    t.add(p, filter=_skip)
    except (OSError, tarfile.TarError) as e:
        bad('打包失败：%s' % e)
        return 1
    try:
        # 备份里有 soga_key / webapi_key / licence 私钥：默认 umask 022 会写成 644，
        # 同机其它用户能读。收紧到 600。
        dst.chmod(0o600)
    except OSError:
        pass
    ok('%s（%d KB）' % (dst, dst.stat().st_size // 1024))
    if keep:
        olds = sorted(outdir.glob('so-backup-*.tar.gz'))
        for old in olds[:-int(keep)] if int(keep) > 0 else []:
            old.unlink(missing_ok=True)
            kv('已清理', old.name)
    left = sorted(outdir.glob('so-backup-*.tar.gz'))
    kv('现有备份', '%d 个（%s）' % (len(left), outdir))
    kv('保留策略', '最近 %s 份（--keep N 调整，--keep 0 = 不清理）' % keep)
    return 0


def cmd_rollback(c, a):
    head('回滚')
    outdir = Path(os.environ.get('SO_BACKUP_DIR') or '/root')
    pick = None
    want = getattr(a, 'file_opt', None) or getattr(a, 'file', None)
    if want:
        # --file 指定时必须先认这个文件：以前先查默认目录（/root）里有没有备份，
        # /root 空就直接「没有备份」返回 1，给了 --file 也没用。
        pick = Path(want)
        if not pick.is_file():
            bad('备份文件不存在：%s' % pick)
            return 1
    else:
        cands = sorted(outdir.glob('so-backup-*.tar.gz'))
        if not cands:
            bad('没有备份（%s）' % outdir)
            return 1
        if not sys.stdin.isatty():
            # 管道 / 脚本里没有「选择 #」这一步可交互；不给 --file 就会一直等 stdin（实测会挂到超时）
            bad('非交互回滚要指定文件：so-console rollback --file <备份文件>')
            return 2
        rows = [[i + 1, p.name, '%d KB' % (p.stat().st_size // 1024)] for i, p in enumerate(cands)]
        table(rows, ['#', '备份', '大小'])
        sel = ask('选择 #（回车取消）', default='', valid=r'\d*')
        if not sel:
            return 0
        n = int(sel)
        if n < 1 or n > len(cands):          # 越界必须拦，否则 IndexError 直接崩
            bad('编号超出范围：%s（1–%d）' % (sel, len(cands)))
            return 2
        pick = cands[n - 1]
    if not getattr(a, 'yes', False):
        if not sys.stdin.isatty():
            bad('非交互回滚要显式确认：so-console rollback --file <备份> --yes')
            return 2
        if not confirm('确认用 %s 覆盖当前 %s 与配置目录？' % (pick.name, c['bin_dir'])):
            return 0
    # tar 成员名不带前导 /，这里统一成无前导 / 的规范形式再比
    allowed = tuple(posixpath.normpath(str(Path(p))).lstrip('/')
                    for p in (c['bin_dir'], c['inst_dir']))

    def _member_ok(name):
        """成员名必须规范化后仍落在允许目录内：挡住 ../、绝对路径、相对根。"""
        if not name or name.startswith('/') or name.startswith('~'):
            return False
        parts = name.split('/')
        if '..' in parts:
            return False
        real = posixpath.normpath(name.lstrip('./')).lstrip('/')
        if real in ('.', ''):
            return False
        return any(real == a or real.startswith(a + '/') for a in allowed)

    try:
        with tarfile.open(pick, 'r:gz') as t:
            members = t.getmembers()
    except (OSError, tarfile.TarError) as e:
        bad('备份打不开：%s' % e)
        return 3
    bads = [m.name for m in members if not _member_ok(m.name)]
    if bads:
        # 前缀匹配会被 `usr/local/soco/../tmp/x` 绕过；这里按规范化后的真实路径判
        bad('备份里有 %d 条路径不安全（穿越 / 越界 / 绝对路径，例：%s），拒绝解包（只允许 %s）'
            % (len(bads), bads[0], ' / '.join(allowed)))
        return 4
    # 只接受「完整的 so 备份」：必须含 bin_dir/soco 且体积像样（真包 82 MB）。
    # 否则随便一个小 tar（比如 4 字节的 soco）就能把主程序覆盖掉——2026-11-27 实测踩过。
    want_soco = posixpath.normpath(str(Path(c['bin_dir']) / 'soco')).lstrip('/')
    soco_m = [m for m in members
              if posixpath.normpath(m.name.lstrip('./')).lstrip('/') == want_soco]
    if not soco_m or soco_m[0].size < 1_000_000:
        bad('这不是一份完整的 so 备份：%s（%s 字节）；拒绝覆盖'
            % ('缺 soco' if not soco_m else 'soco 只有 %d' % soco_m[0].size, want_soco))
        warn('要恢复就先用 so-console backup 生成备份，别手工塞 tar（或 --file 指向错文件了）')
        return 4
    sh(['systemctl', 'stop', c['service']])
    try:
        with tarfile.open(pick, 'r:gz') as t:
            for m in t.getmembers():
                if m.issym() or m.islnk():
                    continue                      # 符号/硬链接一律不落盘
                if not _member_ok(m.name):
                    continue
                try:
                    try:
                        t.extract(m, '/', filter='data')     # python >= 3.12
                    except TypeError:
                        t.extract(m, '/')                   # python 3.9/3.10/3.11（成员已校验）
                except (OSError, tarfile.TarError) as e:
                    warn('跳过 %s：%s' % (m.name, e))
    except (OSError, tarfile.TarError) as e:
        bad('解包失败：%s（服务保持停止，请手动处理）' % e)
        return 3
    got = Path(c['bin_dir']) / 'soco'
    if not got.is_file() or got.stat().st_size < 1_000_000:
        bad('回滚后 %s 不正常（%s 字节）；请手动处理或重新 SO_FORCE_BIN=1 装二进制'
            % (got, got.stat().st_size if got.exists() else 0))
        return 5
    sh(['systemctl', 'start', c['service']])
    # 回滚后同样要等端口就绪：以前 start 完立刻打状态，用户看到 DOWN 以为回滚失败
    st = svc_state(c['service'])
    if st != 'active':
        warn('已恢复 %s，但服务状态是 %s（没在跑）；so-console logs %s 40 看原因'
             % (pick.name, st, c['service']))
        return cmd_status(c, a)
    port = ''
    for _ in range(24):
        time.sleep(1.5)
        port = port_of_service(c['service']) or det_port(c)
        if port and (':%s' % port) in out(['ss', '-lnt']):
            break
    if port and (':%s' % port) in out(['ss', '-lnt']):
        ok('已恢复 %s（:%s 已就绪）' % (pick.name, port))
    else:
        warn('已恢复 %s，但 :%s 还没监听；稍后 so-console status / logs 看一眼' % (pick.name, port or '-'))
    return cmd_status(c, a)


def cmd_verify(c, _a):
