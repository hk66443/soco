    print('port       : %s' % (det_port(c) or '<unknown>'))
    print('arch       : %s (host=%s)' % (c['arch'] or arch(), arch()))
    return 0


def last_user_num(svc):
    rc, s = sh(['journalctl', '-u', svc, '-n', '800', '-o', 'cat'])
    nums = re.findall(r'current user num:\s*(\d+)', s)
    return nums[-1] if nums else '-'


def last_routes_line(svc):
    rc, s = sh(['journalctl', '-u', svc, '-n', '800', '-o', 'cat'])
    for ln in reversed(s.splitlines()):
        if 'load routes config' in ln:
            return ln.split('load routes config')[-1].strip()[:90]
    return '-'


