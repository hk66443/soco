    print('arch        : %s' % (c['arch'] or arch()))
    print('service     : %-10s pid=%-8s restarts=%s' % (
        svc_state(svc), pid or '-',
        out(['systemctl', 'show', svc, '-p', 'NRestarts', '--value']) or '-'))
    if pid and pid not in ('0', ''):
        print('uptime/rss  : %s' % out(['ps', '-o', 'etime=,rss=,pcpu=', '-p', pid]))
    print('port        : %s (%s)' % (port or '-', listening))
    print('users(svc)  : %s' % last_user_num(svc))
    for u in ('soco-licence-sink', 'soco-sink-redirect', 'soco-watchdog'):
        print('%-20s %s' % (u, svc_state(u)))
    print('gate(5m)    : key_err=%d auth_fail=%d relay=%d' % (
        journal_has(svc, 'soga key'), journal_has(svc, 'auth failed'),
        journal_has(svc, 'tcp relay')))
    print('routes      : %s' % last_routes_line(svc))
    print('instances   : %s' % (', '.join(p.stem for p in Path(c['inst_dir']).glob('*.conf')) or '-'))
    binf = Path(c['bin_dir']) / 'soco'
    print('bin hash    : %s' % (out(['sha256sum', str(binf)])[:16] if binf.is_file() else 'MISSING'))
    return 0


def cmd_install(c, a):
    svc, bd, conf = c['service'], Path(c['bin_dir']), Path(c['conf'])
    pkg = Path(a[0]) if a else Path(c['pkg'])
    print('== install  arch=%s  pkg=%s' % (arch(), pkg))
    if os.geteuid() != 0:
        print('!! must run as root')
        return 2
    c['pkg'] = str(pkg)
    for d in (bd, bd / 'licence', Path(c['inst_dir'])):
        d.mkdir(parents=True, exist_ok=True)
    # binaries must be provided by the operator (build script or backup)
    for name in ('soco', 'libsoco.so'):
        f = bd / name
        if not f.is_file():
            for cand in (pkg / 'bin' / name, pkg / 'amd64' / 'bin' / name, pkg / 'arm64' / 'bin' / name):
                if cand.is_file():
                    shutil.copy2(cand, f)
                    break
        if not f.is_file():
            print('!! missing %s â€” put it in %s or %s/bin/ (see DEPLOY.md Â§2)' % (f, bd, pkg))
            return 3
    os.chmod(bd / 'soco', 0o755)
    os.chmod(bd / 'libsoco.so', 0o600)
    # probe client + scripts from the project dir
    for src, dst in ((pkg / '_ops' / 'probe_many.py', bd / 'probe_many.py'),
                     (pkg / 'packaging' / 'soco-watchdog.py', bd / 'soco-watchdog.py'),
                     (pkg / 'packaging' / 'routes-guard.py', bd / 'routes-guard.py')):
        if src.is_file():
            shutil.copy2(src, dst)
            os.chmod(dst, 0o755)
    # licence sink + cert
    sink = pkg / 'amd64' / 'src' / 'licence-sink.py'
    if not (bd / 'licence' / 'sink.py').is_file() and sink.is_file():
        shutil.copy2(sink, bd / 'licence' / 'sink.py')
    if not (bd / 'licence' / 'cert.pem').is_file():
        rc, s = sh(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '3',
                    '-keyout', str(bd / 'licence' / 'key.pem'), '-out', str(bd / 'licence' / 'cert.pem'),
                    '-subj', '/CN=%s' % LICENCE_HOSTS[0],
                    '-addext', 'subjectAltName=DNS:%s' % LICENCE_HOSTS[0]])
        print('   cert: %s' % ('ok' if rc == 0 else 'FAILED ' + s[:120]))
    os.chmod(bd / 'licence' / 'key.pem', 0o600)
    # gate bypass: hosts entries (idempotent)
    hosts = Path('/etc/hosts')
    txt = read_hosts()
    add = [h for h in LICENCE_HOSTS if h not in txt]
    if add:
        with hosts.open('a') as f:
            f.write(''.join('\n127.0.0.1 %s\n' % h for h in add))
        print('   hosts: added %d entries' % len(add))
    # systemd units
    us = Path('/etc/systemd/system')
    for name, tpl in UNITS.items():
        (us / name).write_text(tpl.format(bin_dir=c['bin_dir'], inst_dir=c['inst_dir']), encoding='utf-8')
    print('   units: %d written' % len(UNITS))
    sh(['systemctl', 'daemon-reload'])
    sh(['systemctl', 'enable', '--now', 'soco-licence-sink.service', 'soco-sink-redirect.service'])
    sh(['systemctl', 'enable', '--now', svc + '.service'])
    if (bd / 'soco-watchdog.py').is_file():
        sh(['systemctl', 'enable', '--now', 'soco-watchdog.service'])
    cfg_save(c)
    print('   console.conf written -> %s' % CFG)
    time.sleep(6)
    cmd_gate(c, [])
    print('next: %s probe 3   (%s doctor)' % (sys.argv[0], sys.argv[0]))
    return 0


def cmd_service(c, a):
    act = a[0] if a else 'status'
    svc = c['service']
    if act not in ('start', 'stop', 'restart', 'status'):
        print('usage: service start|stop|restart|status')
        return 2
    if act != 'status':
        for u in ('soco-licence-sink', 'soco-sink-redirect') if act != 'stop' else ():
            sh(['systemctl', act, u])
        rc, s = sh(['systemctl', act, svc + '.service'])
        print(s.strip() or 'ok')
    return cmd_status(c, [])


def cmd_users(c, _a):
