ANSI = sys.stdout.isatty() and os.environ.get('NO_COLOR') is None


def col(code, s):
    return '\033[%sm%s\033[0m' % (code, s) if ANSI else s


B, D, G, Y, R = '1', '2', '32', '33', '31'


def rule(title=''):
    line = '─' * 62
    print(col(B, '── %s %s' % (title, line[len(title) + 3:])) if title else col(D, line))


def head(title):
    print()
    print(col(B, '╭─ %s' % title))
    print(col(D, '╰' + '─' * 62))


def say(msg=''):
    print(msg)


def _w(s):
    """显示宽度：CJK/全角按 2 列算，用于对齐。"""
    return sum(2 if ord(ch) > 0x2E7F else 1 for ch in str(s))


def _pad(s, width):
    s = str(s)
    return s + ' ' * max(0, width - _w(s))


def kv(k, v, width=22):
    print('  %s%s %s' % (col(D, _pad(k, width)), col(D, '·'), v))


def ok(msg):
    print('  %s %s' % (col(G, '✔'), msg))


def warn(msg):
    print('  %s %s' % (col(Y, '!'), msg))


def bad(msg):
    print('  %s %s' % (col(R, '✘'), msg))


def step(i, n, name, state='', note=''):
    if state == 'run' and not ANSI:      # non-tty: only print the result line
        return
    tag = {'run': col(Y, '…'), 'ok': col(G, 'PASS'), 'fail': col(R, 'FAIL'),
           'skip': col(D, 'SKIP')}.get(state, '')
    print('  [%d/%d] %s %s %s %s' % (i, n, _pad(name, 26), col(D, '·' * 8), tag, note))


def table(rows, headers):
    cols = [str(h) for h in headers] + [str(x) for r in rows for x in r]
    widths = [max(_w(str(r[i])) for r in [headers] + rows) for i in range(len(headers))]
    print('  ' + '  '.join(col(B, _pad(str(h), widths[i])) for i, h in enumerate(headers)))
    print('  ' + '  '.join(col(D, '─' * widths[i]) for i in range(len(headers))))
    for r in rows:
        print('  ' + '  '.join(_pad(str(r[i]), widths[i]) for i in range(len(headers))))


def ask(label, default=None, valid=None, hint=''):
    while True:
        tail = ' [%s]' % default if default else ''
        try:
            v = input('  %s%s: ' % (label, col(D, tail))).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            raise SystemExit(130)
        if not v and default:
            v = default
        if v and (valid is None or re.fullmatch(valid, v)):
            return v
        if v:
            warn(hint or '格式不对，请重输')


def confirm(label, default='n'):
    try:
        v = input('  %s [%s]: ' % (label, 'Y/n' if default == 'y' else 'y/N')).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        raise SystemExit(130)
    return (v or default) == 'y'


