        print('panel users                : <no config>')
        return 0
    k = dict(l.split('=', 1) for l in panel.read_text().splitlines()
             if '=' in l and not l.lstrip().startswith('#'))
    url, nid, key = k.get('webapi_url', ''), k.get('node_id', ''), k.get('webapi_key', '')
