def run_cmd(c, name, args):
    fn = globals().get('cmd_' + name)
    if not fn:
        print('unknown command: %s' % name)
        return 2
    return fn(c, args)


def interactive(c):
    while True:
        print('\n' + '=' * 58)
        print(' so-console Â· %s Â· %s' % (c['arch'] or arch(), time.strftime('%F %T')))
        print('=' * 58)
        for k, name, desc in MENU:
            print('%3s) %-9s %s' % (k, name, desc))
        print('   0) é€€å‡º')
        try:
            sel = input('so> ').strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if sel in ('0', 'q', 'quit', 'exit'):
            return 0
        hit = [m for m in MENU if m[0] == sel]
        if not hit:
            # allow typing a command directly:  probe 497 / routes switch tw
            parts = sel.split()
            if parts:
                run_cmd(c, parts[0], parts[1:])
            continue
        name = hit[0][1]
        extra = []
        if name in ('service', 'probe', 'routes', 'inst', 'logs', 'rollback'):
            try:
                extra = input('  args for %s (blank=default): ' % name).split()
            except EOFError:
                extra = []
        run_cmd(c, name, extra)


