def build_parser():
    p = argparse.ArgumentParser(prog='so-console', add_help=False, description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd')

    pi = sub.add_parser('install', add_help=False)
    pi.add_argument('--node-id')
    pi.add_argument('--type', dest='stype',
                    choices=['ss', 'vless', 'vmess', 'trojan', 'anytls', 'hysteria'])
    pi.add_argument('--url')
    pi.add_argument('--webapi-key')
    pi.add_argument('--soga-key')
    pi.add_argument('--cert-mode', choices=['panel', 'self', 'file', 'http', 'dns'])
    pi.add_argument('--cert-domain')
    pi.add_argument('--cert-file')
    pi.add_argument('--cert-key')
    pi.add_argument('--dns-provider')
    pi.add_argument('--name', default='main')
    pi.add_argument('--dry-run', action='store_true')
    pi.add_argument('--no-probe', action='store_true')

    pn = sub.add_parser('inst', add_help=False)
    pn.add_argument('action', nargs='?', default='list')
    pn.add_argument('name', nargs='?')
    pn.add_argument('--node-id')
    pn.add_argument('--type', dest='stype',
                    choices=['ss', 'vless', 'vmess', 'trojan', 'anytls', 'hysteria'])
    pn.add_argument('--url')
    pn.add_argument('--webapi-key')
    pn.add_argument('--soga-key')
    pn.add_argument('--cert-mode', choices=['panel', 'self', 'file', 'http', 'dns'])
    pn.add_argument('--cert-domain')
    pn.add_argument('--cert-file')
    pn.add_argument('--cert-key')
    pn.add_argument('--dns-provider')
    pn.add_argument('--dry-run', action='store_true')
    pn.add_argument('--no-probe', action='store_true')

    ps = sub.add_parser('service', add_help=False)
    ps.add_argument('action', nargs='?', default='status',
                    choices=['start', 'stop', 'restart', 'status'])

    pp = sub.add_parser('probe', add_help=False)
    pp.add_argument('count', nargs='?', default='3')
    pp.add_argument('idx', nargs='?')

    pl = sub.add_parser('logs', add_help=False)
    pl.add_argument('unit', nargs='?')
    pl.add_argument('lines', nargs='?', type=int)

    pr = sub.add_parser('routes', add_help=False)
    pr.add_argument('action', nargs='?', default='status', choices=['status', 'show', 'validate'])

    pb = sub.add_parser('rollback', add_help=False)
    pb.add_argument('file', nargs='?')

    pbk = sub.add_parser('backup', add_help=False)
    pbk.add_argument('--keep', type=int)

    for name in ('status', 'users', 'gate', 'doctor', 'verify', 'paths', 'help'):
        sub.add_parser(name, add_help=False)
    return p


