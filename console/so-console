def _unit_names(c):
    """本项目可能留下的所有单元名（含多实例）。"""
    names = ['soco', 'soco-watchdog', 'soco-licence-sink', 'soco-sink-redirect',
             'soco-routes-guard.path', 'soco-routes-guard.service', 'soco-mesh', 'soga']
    try:
        for p in Path(c['inst_dir']).glob('*.conf'):
            if p.stem not in ('soga', 'soco'):
                names.append('soco@%s' % p.stem)
    except OSError:
        pass
    try:
        for ln in Path('/etc/systemd/system/multi-user.target.wants').glob('soco@*.service'):
            n = ln.name[:-len('.service')]
            if n not in names:
                names.append(n)
    except OSError:
        pass
    return names


def nft_uninstall_cmds():
    """卸载时的 nft 清理命令：**只删本项目自己的东西**。

    ⚠ 只删 `ip nat` 表里我们加的 `redir` 链，**绝对不删整张 `ip nat` 表**：
    docker / iptables-nft / 防火墙也用这张表，早期版本在这里 `delete table ip nat`，
    会把同机别的 NAT 规则一起清空（客户机器上等于把容器网络打断）。
    """
    return [['nft', 'delete', 'chain', 'ip', 'nat', 'redir'],
            ['nft', 'delete', 'table', 'ip', 'soco_sink']]


def strip_hosts_lines(path, hosts):
    """删掉 hosts 里本项目加的授权域名行，**原子写回**，返回删除条数。

    - 只匹配「注释去掉后最后一个字段是这些域名」的行，避免误删注释里偶然出现的域名；
    - 先写临时文件再 os.replace：中途被杀不会留下半截 /etc/hosts（那是 DNS 全挂）。
    """
    p = Path(path)
    lines = p.read_text(errors='replace').splitlines()
    kept, removed = [], 0
    for ln in lines:
        body = ln.split('#', 1)[0].strip()
        fields = body.split()
        if fields and fields[-1] in hosts:
            removed += 1
            continue
        kept.append(ln)
    if removed:
        tmp = p.with_name(p.name + '.so-tmp')
        tmp.write_text('\n'.join(kept) + '\n', encoding='utf-8')
        try:
            os.chmod(tmp, p.stat().st_mode & 0o7777)
        except OSError:
            pass
        os.replace(str(tmp), str(p))
    return removed


def cmd_uninstall(c, a):
    """卸载本项目：停服务 → 删单元 → 删目录/日志 → 清 hosts / nft。

    默认**保留配置**（/etc/soga 里的 soga.conf / routes.toml / 证书），方便以后重装；
    `--purge` 连配置一起删。`--yes` 用于非交互。
    """
    head('卸载本项目')
    purge = bool(getattr(a, 'purge', False))
    yes = bool(getattr(a, 'yes', False))
    units = _unit_names(c)
    dirs = [Path(c['bin_dir']), Path(c['pkg'])]
    if purge:
        dirs += [Path(c['inst_dir']), Path('/etc/soco'), Path('/etc/so')]
    kv('将停止/删除单元', ', '.join(units))
    kv('将删除目录', ', '.join(str(d) for d in dirs))
    kv('配置', '删除（--purge）' if purge else '保留 %s' % c['inst_dir'])
    kv('hosts / nft', '清理 4 条授权域名 + 本项目建的 nft 链（不删整张 ip nat 表）')
    if not yes:
        if not sys.stdin.isatty():
            bad('非交互卸载要显式确认：so-console uninstall --yes [--purge]')
            return 2
        if not confirm('确认卸载（服务会停、目录会删）？'):
            return 0

    fails = 0
    # 只 stop/disable 真正存在的单元：以前把 _unit_names() 里猜的名字全喂给 systemctl，
    # 不存在的单元会刷一屏 "Unit xxx.service not loaded"，看着像卸载失败
    us_dir = Path('/etc/systemd/system')
    wants = us_dir / 'multi-user.target.wants'
    present = [u for u in units
               if (us_dir / (u + '.service')).exists() or (wants / (u + '.service')).exists()]
    for u in present:
        sh(['systemctl', 'stop', u])
        sh(['systemctl', 'disable', u])
    for pat in ('soco*.service', 'soco*.path', 'soco*.timer', 'soga*.service'):
        for f in Path('/etc/systemd/system').glob(pat):
            try:
                f.unlink()
            except OSError as e:
                warn('删不掉 %s：%s' % (f, e))
                fails += 1
    shutil.rmtree('/etc/systemd/system/soga.service.d', ignore_errors=True)
    sh(['systemctl', 'daemon-reload'])
    sh(['systemctl', 'reset-failed'])
    ok('已停服务并删除单元')

    # 按可执行路径杀残留（不要 pkill -f：模式串会出现在自己的命令行里）
    killed = 0
    for pid_dir in Path('/proc').iterdir():
        if not pid_dir.name.isdigit():
            continue
        try:
            exe = os.readlink(str(pid_dir / 'exe'))
        except OSError:
            continue
        if exe.startswith(str(Path(c['bin_dir']))) or '/usr/local/soga/' in exe:
            try:
                os.kill(int(pid_dir.name), 9)
                killed += 1
            except OSError:
                pass
    kv('清理残留进程', '%d 个' % killed)

    for d in dirs:
        shutil.rmtree(str(d), ignore_errors=True)
        if d.exists():
            warn('删不掉 %s（权限？）' % d)
            fails += 1
    for f in ('/var/log/soco-watchdog.log', '/var/log/soco-watchdog.log.1',
              '/usr/bin/soco', '/usr/bin/soga', '/usr/bin/soco-uninstall',
              '/usr/bin/soco-verify', '/usr/bin/soco-multi'):
        try:
            Path(f).unlink(missing_ok=True)
        except OSError:
            pass
    for g in ('/tmp/probe-multi-*', '/var/tmp/probe-multi-*', '/var/tmp/so-bin.*',
              '/var/tmp/so-clone.*'):
        for p in Path('/').glob(g.lstrip('/')):
            shutil.rmtree(str(p), ignore_errors=True)
    ok('已删除目录与日志')

    # hosts：只删本项目加的 4 条（原子写回，见 strip_hosts_lines 的说明）
    try:
        removed = strip_hosts_lines('/etc/hosts', LICENCE_HOSTS)
        kv('hosts', '删除 %d 条授权域名' % removed if removed else '无本项目条目')
    except OSError as e:
        warn('/etc/hosts 处理失败：%s' % e)
        fails += 1

    # nft：只删本项目自己的链/遗留表，**ip nat 表本身保留**（docker/iptables 也用这张表）
    for cmd in nft_uninstall_cmds():
        sh(cmd)
    if 'redir' in out(['nft', 'list', 'chain', 'ip', 'nat', 'redir']):
        warn('nft 链 ip nat redir 还在（可能被别的组件按同名重建了，手工确认下）')
    kv('nft', '已删本项目链 ip nat redir / 遗留表 ip soco_sink（ip nat 表保留）')

    left_units = [u for u in units if (Path('/etc/systemd/system') / (u + '.service')).exists()]
    kv('剩余单元', ', '.join(left_units) or '无')
    kv('剩余目录', ', '.join(str(d) for d in dirs if d.exists()) or '无')
    say('')
    if fails or left_units:
        bad('卸载未完全成功（见上面的警告）')
        return 1
    ok('卸载完成%s' % ('（配置已一并删除）' if purge else '（配置保留在 %s）' % c['inst_dir']))
    return 0


